<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temp Phase Warning"
        Width="760"
        MinWidth="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F6FA">
    <Border Margin="18"
            Padding="24"
            Background="White"
            BorderBrush="#D6DEE8"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Width="42"
                      Height="42"
                      VerticalAlignment="Top">
                    <Image x:Name="warning_icon_image"
                           Width="36"
                           Height="36"
                           Stretch="Uniform"
                           Visibility="Collapsed" />
                    <TextBlock x:Name="warning_icon_fallback"
                               Text="&#x26A0;"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#D9822B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="warning_message"
                           Grid.Column="1"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="#3D78B5"
                           MaxWidth="560"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="restored_heading"
                       Grid.Row="1"
                       Margin="54,16,0,0"
                       Text="Temporary phase/view state has been restored."
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#3D78B5"
                       />

            <StackPanel Grid.Row="2"
                        Margin="0,24,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="save_btn"
                        Content="Save Restored File and Close"
                        Width="204"
                        Height="34"
                        Background="#3D78B5"
                        Foreground="White"
                        BorderBrush="#3D78B5" />
                <Button x:Name="sync_btn"
                        Content="Synchronize Restored File and Close"
                        Width="244"
                        Height="34"
                        Margin="10,0,0,0"
                        Background="#3D78B5"
                        Foreground="White"
                        BorderBrush="#3D78B5" />
                <Button x:Name="keep_open_btn"
                        Content="Keep File Open"
                        Width="124"
                        Height="34"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        IsCancel="True"
                        Background="White"
                        Foreground="#385A7D"
                        BorderBrush="#B7C4D2" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
