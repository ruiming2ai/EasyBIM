<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temp Phase &amp; View"
        Width="620"
        MinWidth="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F6FA">
    <Border Margin="18"
            Padding="24"
            Background="White"
            BorderBrush="#D6DEE8"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="6"
                        Height="54"
                        Background="#3D78B5"
                        CornerRadius="3"
                        VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="TEMP PHASE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#3D78B5" />
                    <TextBlock Text="Set or Restore Temporary Phase"
                               Margin="0,2,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#25364A" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="view_label"
                       Grid.Row="1"
                       Margin="20,12,0,18"
                       TextWrapping="Wrap"
                       Foreground="#5C6B7A"
                       FontSize="12" />

            <StackPanel Grid.Row="2">
                <TextBlock Text="Choose the phase to apply temporarily:"
                           Margin="0,0,0,7"
                           Foreground="#385A7D"
                           FontSize="12" />
                <ComboBox x:Name="phase_cb"
                          Height="34"
                          MinWidth="460"
                          Padding="8,2"
                          VerticalContentAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button x:Name="restore_btn"
                            Content="Restore"
                            Width="104"
                            Height="34"
                            ToolTip="Restore the active view to its original phase and clear its temporary view settings."
                            Background="White"
                            Foreground="#385A7D"
                            BorderBrush="#B7C4D2" />
                    <Button x:Name="restore_all_btn"
                            Content="Restore All Views"
                            Width="140"
                            Height="34"
                            Margin="8,0,0,0"
                            ToolTip="Restore every view in this document and clear all temporary view settings."
                            Background="White"
                            Foreground="#385A7D"
                            BorderBrush="#B7C4D2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="apply_btn"
                            Content="Apply"
                            Width="104"
                            Height="34"
                            IsDefault="True"
                            Background="#3D78B5"
                            Foreground="White"
                            BorderBrush="#3D78B5" />
                    <Button x:Name="cancel_btn"
                            Content="Cancel"
                            Width="104"
                            Height="34"
                            Margin="10,0,0,0"
                            IsCancel="True"
                            Background="White"
                            Foreground="#385A7D"
                            BorderBrush="#B7C4D2" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
