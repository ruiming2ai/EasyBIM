<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Detected"
        Width="540"
        Height="380"
        MinWidth="440"
        MinHeight="280"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText"
                       Text="New clash detected"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#B03000" />
            <TextBlock x:Name="ScopeText"
                       Foreground="DimGray"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,2,0,8" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1">
            <ListBox x:Name="RowsListView"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="rows_double_click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gainsboro"
                                BorderThickness="0,0,0,1"
                                Padding="6,7,6,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding is_checked, Mode=TwoWay}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,8,0"
                                          Click="row_check_click" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding element_a_title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding element_a_detail}"
                                               Foreground="DimGray"
                                               FontSize="11" />
                                    <TextBlock Text="clashes with"
                                               Foreground="#B05000"
                                               FontSize="11"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding element_b_title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding element_b_detail}"
                                               Foreground="DimGray"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button x:Name="SelectAllButton"
                    Content="All"
                    Width="72"
                    Height="30"
                    Margin="0,0,6,0"
                    Click="select_all_click" />
            <Button x:Name="SelectNoneButton"
                    Content="None"
                    Width="72"
                    Height="30"
                    Margin="0,0,6,0"
                    Click="select_none_click" />
            <Button x:Name="ShowButton"
                    Content="Show"
                    Width="110"
                    Height="30"
                    ToolTip="Select and zoom to every element of the ticked clashes."
                    Click="show_click" />
        </StackPanel>

        <DockPanel Grid.Row="3"
                   LastChildFill="False"
                   Margin="0,8,0,0">
            <Button x:Name="PauseButton"
                    Content="Pause"
                    Width="86"
                    Height="30"
                    DockPanel.Dock="Left"
                    Margin="0,0,6,0"
                    Click="pause_click" />
            <Button x:Name="ResumeButton"
                    Content="Resume"
                    Width="86"
                    Height="30"
                    DockPanel.Dock="Left"
                    Margin="0,0,6,0"
                    IsEnabled="False"
                    Click="resume_click" />
            <Button x:Name="StopButton"
                    Content="Stop Detection"
                    Width="122"
                    Height="30"
                    DockPanel.Dock="Left"
                    Click="stop_click" />

            <Button x:Name="DismissButton"
                    Content="Dismiss"
                    Width="86"
                    Height="30"
                    DockPanel.Dock="Right"
                    Margin="6,0,0,0"
                    IsCancel="True"
                    Click="dismiss_click" />
            <Button x:Name="SilentModeButton"
                    Content="Silent Mode"
                    Width="110"
                    Height="30"
                    DockPanel.Dock="Right"
                    ToolTip="Stop popping up and keep updating the right-side panel instead."
                    Click="silent_click" />
        </DockPanel>
    </Grid>
</Window>
