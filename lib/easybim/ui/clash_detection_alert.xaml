<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Detected"
        Width="470"
        Height="340"
        MinWidth="380"
        MinHeight="240"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText"
                       Text="New clash detected"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#B03000" />
            <TextBlock x:Name="ScopeText"
                       Foreground="DimGray"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,2,0,8" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1">
            <ListBox x:Name="RowsListView"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gainsboro"
                                BorderThickness="0,0,0,1"
                                Padding="6,7,6,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding element_a_title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding element_a_detail}"
                                               Foreground="DimGray"
                                               FontSize="11" />
                                    <TextBlock Text="clashes with"
                                               Foreground="#B05000"
                                               FontSize="11"
                                               Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding element_b_title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding element_b_detail}"
                                               Foreground="DimGray"
                                               FontSize="11" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Show"
                                        Width="64"
                                        Height="26"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Top"
                                        Click="show_click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="0,10,0,0">
            <Button Content="Stop Detection"
                    Width="120"
                    Height="30"
                    DockPanel.Dock="Left"
                    Click="stop_click" />
            <Button Content="Dismiss"
                    Width="96"
                    Height="30"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="dismiss_click" />
            <Button Content="Silent Mode"
                    Width="120"
                    Height="30"
                    DockPanel.Dock="Right"
                    ToolTip="Stop popping up and keep updating the right-side panel instead."
                    Click="silent_click" />
        </DockPanel>
    </Grid>
</Window>
