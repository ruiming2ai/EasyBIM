<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Height="34" MinHeight="34" MaxHeight="34"
      Background="#F6F7F9">
  <DockPanel LastChildFill="True" Margin="8,3">
    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel"
            Click="cancel_click" Width="72" Height="26" Margin="8,0,0,0" Padding="6,1"/>
    <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Width="44"
               VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>
    <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="180" Height="12"
                 VerticalAlignment="Center" Minimum="0" Maximum="1" Margin="10,0,8,0"/>
    <TextBlock x:Name="PhaseText" DockPanel.Dock="Left" MinWidth="115" MaxWidth="210"
               VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"
               TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="DetailText" VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
  </DockPanel>
</Page>
