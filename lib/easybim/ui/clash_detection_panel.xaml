<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText"
                       Text="Clash Detection Mode"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ScopeText"
                       Foreground="DimGray"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,2,0,6" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1">
            <Grid>
                <ListBox x:Name="RowsListView"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="rows_double_click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gainsboro"
                                    BorderThickness="0,0,0,1"
                                    Padding="6,7,6,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding is_checked, Mode=TwoWay}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,8,0"
                                              Click="row_check_click" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding element_a_title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding element_a_detail}"
                                                   Foreground="DimGray"
                                                   FontSize="11" />
                                        <TextBlock Text="clashes with"
                                                   Foreground="#B05000"
                                                   FontSize="11"
                                                   Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding element_b_title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding element_b_detail}"
                                                   Foreground="DimGray"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           Text="No new clashes yet. Keep modeling - only clashes created from now on are reported."
                           Foreground="DimGray"
                           TextWrapping="Wrap"
                           Margin="10"
                           VerticalAlignment="Top" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,6,0,6"
                   TextWrapping="Wrap"
                   Foreground="DimGray" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SelectAllButton"
                    Content="All"
                    Height="28"
                    Margin="0,0,4,4"
                    Click="select_all_click" />
            <Button x:Name="SelectNoneButton"
                    Grid.Column="1"
                    Content="None"
                    Height="28"
                    Margin="0,0,4,4"
                    Click="select_none_click" />
            <Button x:Name="ShowButton"
                    Grid.Column="2"
                    Content="Show"
                    Height="28"
                    Margin="0,0,0,4"
                    ToolTip="Select and zoom to every element of the ticked clashes."
                    Click="show_click" />

            <Button x:Name="PauseButton"
                    Grid.Row="1"
                    Content="Pause"
                    Height="28"
                    Margin="0,0,4,4"
                    Click="pause_click" />
            <Button x:Name="ResumeButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Content="Resume"
                    Height="28"
                    Margin="0,0,4,4"
                    IsEnabled="False"
                    Click="resume_click" />
            <Button x:Name="EditCategoriesButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    Content="Categories"
                    Height="28"
                    Margin="0,0,0,4"
                    ToolTip="Edit the categories being watched."
                    Click="edit_categories_click" />

            <Button x:Name="StopButton"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Content="Stop Detection"
                    Height="30"
                    Click="stop_click" />
        </Grid>
    </Grid>
</UserControl>
