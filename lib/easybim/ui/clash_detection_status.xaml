<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Detection Mode"
        Width="480"
        Height="400"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="StateText"
                       Text="Running"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ElapsedText"
                       Foreground="DimGray"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#E3E3E3"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="12"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Watching"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ScopeText"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="CategoriesText"
                           Foreground="DimGray"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Border BorderBrush="#E3E3E3"
                    BorderThickness="1"
                    Background="#FAFAFA"
                    Padding="12,8,12,8"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="ActiveCountText"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="live clashes"
                               Foreground="DimGray"
                               FontSize="11" />
                </StackPanel>
            </Border>
            <Border BorderBrush="#E3E3E3"
                    BorderThickness="1"
                    Background="#FAFAFA"
                    Padding="12,8,12,8"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="ResolvedCountText"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="resolved"
                               Foreground="DimGray"
                               FontSize="11" />
                </StackPanel>
            </Border>
            <Border BorderBrush="#E3E3E3"
                    BorderThickness="1"
                    Background="#FAFAFA"
                    Padding="12,8,12,8">
                <StackPanel>
                    <TextBlock x:Name="QueuedCountText"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="queued"
                               Foreground="DimGray"
                               FontSize="11" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock x:Name="NotesText"
                   Grid.Row="3"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   VerticalAlignment="Top" />

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ShowPanelButton"
                        Content="Show Panel"
                        Width="112"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="show_panel_click" />
                <Button x:Name="PauseButton"
                        Content="Pause"
                        Width="112"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="pause_click" />
                <Button x:Name="ResumeButton"
                        Content="Resume"
                        Width="112"
                        Height="32"
                        IsEnabled="False"
                        Click="resume_click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">
                <Button x:Name="EditCategoriesButton"
                        Content="Edit Categories"
                        Width="140"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="edit_categories_click" />
                <Button x:Name="StopButton"
                        Content="Stop Detection"
                        Width="140"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="stop_click" />
                <Button x:Name="CloseButton"
                        Content="Close"
                        Width="92"
                        Height="32"
                        IsCancel="True"
                        Click="close_click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
