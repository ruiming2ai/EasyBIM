<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circuit Schedule"
        Width="420" Height="760"
        MinWidth="320" MinHeight="420"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Text="Circuit Schedule"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Height="24"
                     VerticalContentAlignment="Center"
                     ToolTip="Circuit number, panel, load name or element id. A number matches a whole circuit number, so 12 does not find 112."
                     TextChanged="search_changed"
                     PreviewKeyDown="search_key_down" />
            <Button x:Name="ClearSearchButton"
                    Grid.Column="1"
                    Content="&#x2715;"
                    Width="24"
                    Height="24"
                    Margin="4,0,0,0"
                    ToolTip="Clear the search"
                    Click="clear_search_click" />
        </Grid>

        <TextBlock x:Name="PathText"
                   Grid.Row="2"
                   Foreground="DimGray"
                   FontSize="11"
                   Margin="0,6,0,4"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="The full upstream path of the selected row." />

        <Border Grid.Row="3"
                BorderBrush="#D0D0D0"
                BorderThickness="1">
            <Grid>
                <TreeView x:Name="TreeRoot"
                          BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="tree_selection_changed"
                          MouseDoubleClick="tree_double_click">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <!-- Containers are virtualized, so ContainerFromItem
                                 returns null for an unrealized row.  Binding
                                 IsExpanded here is the only way Expand All and
                                 the search can open the tree from code. -->
                            <Setter Property="IsExpanded"
                                    Value="{Binding is_expanded, Mode=TwoWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding is_visible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding children}">
                            <Border x:Name="RowBorder"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="{Binding accent}"
                                    Padding="6,3,4,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GlyphText"
                                               Text="{Binding glyph}"
                                               Foreground="{Binding accent}"
                                               VerticalAlignment="Top"
                                               Margin="0,1,6,0" />
                                    <TextBlock x:Name="NumberText"
                                               Grid.Column="1"
                                               Text="{Binding number_text}"
                                               FontWeight="SemiBold"
                                               Foreground="#7A4C00"
                                               VerticalAlignment="Top"
                                               Margin="0,0,6,0" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TitleText"
                                                   Text="{Binding title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="SubtitleText"
                                                   Text="{Binding subtitle}"
                                                   FontSize="10"
                                                   Foreground="DimGray"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="DetailText"
                                               Grid.Column="3"
                                               Text="{Binding detail}"
                                               FontSize="10"
                                               Foreground="DimGray"
                                               VerticalAlignment="Top"
                                               Margin="6,1,0,0" />
                                </Grid>
                            </Border>
                            <HierarchicalDataTemplate.Triggers>
                                <!-- A board is bold; a device is small and grey.
                                     That contrast is what makes a downstream
                                     panel read differently from a receptacle. -->
                                <DataTrigger Binding="{Binding node_kind}" Value="equipment">
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding node_kind}" Value="circuit">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="#7A4C00" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding node_kind}" Value="load">
                                    <Setter TargetName="TitleText" Property="FontSize" Value="11" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="#404040" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding node_kind}" Value="bucket">
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="DimGray" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding is_reference}" Value="True">
                                    <Setter TargetName="TitleText" Property="FontStyle" Value="Italic" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="DimGray" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding is_cycle}" Value="True">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="#B05000" />
                                    <Setter TargetName="SubtitleText" Property="Foreground" Value="#B05000" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding matched}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#FFF6C8" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock x:Name="EmptyText"
                           Text="This model has no electrical circuits."
                           Foreground="DimGray"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Foreground="DimGray"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <TextBlock x:Name="LegendText"
                   Grid.Row="5"
                   Foreground="DimGray"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Text="&#x25a3; board&#x2003;&#x25bc; circuit&#x2003;&#x25aa; load&#x2003;italic = shown elsewhere&#x2003;orange = circular feed" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="ExpandAllButton"
                    Content="Expand All"
                    MinWidth="80"
                    Height="24"
                    Margin="0,0,6,0"
                    Click="expand_all_click" />
            <Button x:Name="CollapseAllButton"
                    Content="Collapse All"
                    MinWidth="80"
                    Height="24"
                    Margin="0,0,6,0"
                    Click="collapse_all_click" />
            <Button x:Name="ShowButton"
                    Content="Show"
                    MinWidth="70"
                    Height="24"
                    Margin="0,0,6,0"
                    ToolTip="Select and zoom to the selected row in the active view."
                    Click="show_click" />
            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    MinWidth="70"
                    Height="24"
                    ToolTip="Re-read the circuits from the open model."
                    Click="refresh_click" />
        </StackPanel>
    </Grid>
</Window>
