<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Revit Links"
        Width="720"
        Height="600"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Select Revit Links" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Families come straight out of the link, so the .rvt is never opened. Links nested inside a link are not reachable and are not listed."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="link_count_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Search links" FontSize="11" FontWeight="SemiBold"
                           Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="LinkSearchBox" Height="28" VerticalAlignment="Center" TextChanged="link_search_changed"/>
            </DockPanel>

            <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LinkListPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Select All" Width="100" Height="34" Margin="0,0,8,0" Click="link_select_all_click"/>
                    <Button Content="Select None" Width="100" Height="34" Click="link_select_none_click"/>
                    <CheckBox x:Name="hide_unchecked_cb" Content="Hide Un-checked" VerticalAlignment="Center"
                              Margin="12,0,0,0" Click="hide_unchecked_click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                    <Button Content="Next" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="next_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
