<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slope"
        Height="430"
        Width="780"
        MinHeight="390"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Slope" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="Update the built-in Slope parameter on the current selection."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Selection:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="selection_count_tb" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="Select"
                        Width="120"
                        Height="32"
                        Margin="12,0,0,0"
                        Click="select_click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Slope Value:" VerticalAlignment="Center"/>
                <TextBox x:Name="slope_value_tb"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="32"
                         Padding="8,4,8,4"
                         VerticalContentAlignment="Center"/>
                <TextBlock x:Name="unit_symbol_tb"
                           Grid.Row="0"
                           Grid.Column="2"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Unit:" Margin="0,12,0,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="unit_cb"
                          Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Height="32"
                          Margin="0,12,0,0"
                          Padding="6,2,6,2"
                          SelectionChanged="unit_changed"/>

                <TextBlock x:Name="helper_tb"
                           Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,14,0,0"
                           Foreground="DimGray"
                           TextWrapping="Wrap"/>

                <Border Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,14,0,0"
                        BorderBrush="#E6E6E6"
                        BorderThickness="1"
                        Padding="10"
                        Background="#FAFAFA">
                    <StackPanel>
                        <TextBlock Text="Only built-in Slope parameters are targeted."
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="The command targets explicit built-in slope parameters only. If direct parameter writing is blocked, straight line-based MEP curves fall back to a center-fixed geometry update."
                                   Margin="0,6,0,0"
                                   Foreground="DimGray"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="status_tb"
                           Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,14,0,0"
                           Foreground="DimGray"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Run" Width="120" Height="36" Margin="0,0,8,0" Click="run_click"/>
                <Button Content="Cancel" Width="120" Height="36" Click="cancel_click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
