<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Align"
        Height="700"
        Width="1080"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <DataTemplate x:Key="SheetRowTemplate">
            <!-- No Click here: the template is stamped once per row, so the
                 handler is attached once on the list instead. -->
            <CheckBox Margin="0,2,0,2"
                      Content="{Binding display_name}"
                      IsChecked="{Binding is_checked, Mode=TwoWay}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Sheet Align" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="Everything a sheet owns moves as one block - title block, viewports, text, lines and images together."
                       Margin="0,6,0,0" FontSize="13" Foreground="DimGray"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Align To" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" BorderBrush="#E3E3E3" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <!-- Unnamed on purpose: the group is exclusive, so
                                 _selected_mode only has to read the other one. -->
                            <RadioButton GroupName="align_mode"
                                         Content="By Sheet Origin"
                                         IsChecked="True"
                                         Checked="align_mode_changed"/>
                            <TextBlock Margin="20,2,0,10" FontSize="11" Foreground="DimGray" TextWrapping="Wrap"
                                       Text="Each sheet's title block moves onto that sheet's own zero point. No reference sheet is used."/>

                            <RadioButton x:Name="by_title_block_rb"
                                         GroupName="align_mode"
                                         Content="By Title Block Origin"
                                         Checked="align_mode_changed"/>
                            <TextBlock Margin="20,2,0,0" FontSize="11" Foreground="DimGray" TextWrapping="Wrap"
                                       Text="Each sheet's title block moves to where the reference sheet's title block sits."/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ref_sheet_label" Grid.Column="0" Text="Reference sheet:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ref_sheet_cb" Grid.Column="1" Height="30" Margin="8,0,0,0"
                                  DisplayMemberPath="display_name"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="DimGray" TextWrapping="Wrap"
                               Text="Pinned elements are unpinned to move and pinned again afterwards. A pin that will not go back is reported and the run carries on."/>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sheets To Align" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="sheet_search_tb" Width="300" Height="28" Padding="6,2,6,2"
                                 VerticalContentAlignment="Center" TextChanged="sheet_search_changed"/>
                        <Button Content="Check All Visible" Margin="10,0,6,0" Width="128" Height="28" Click="check_all_visible_click"/>
                        <Button Content="Clear" Width="74" Height="28" Click="clear_sheets_click"/>
                    </StackPanel>

                    <ListBox x:Name="sheet_lb"
                             Grid.Row="2"
                             BorderBrush="#B9B9B9"
                             BorderThickness="1"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             HorizontalContentAlignment="Stretch"
                             ItemTemplate="{StaticResource SheetRowTemplate}"/>

                    <TextBlock x:Name="sheet_count_tb" Grid.Row="3" Margin="0,8,0,0" Foreground="DimGray"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status_tb" Grid.Column="0" VerticalAlignment="Center" Foreground="DimGray" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Run" Width="120" Height="36" Margin="0,0,8,0" Click="run_click"/>
                    <Button Content="Cancel" Width="120" Height="36" Click="cancel_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
