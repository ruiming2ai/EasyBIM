<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sort"
        Height="300"
        Width="560"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Sort the table by up to four columns, like native schedule sorting/grouping."
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <StackPanel x:Name="levels_sp" Grid.Row="1"/>
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="clear_b"
                    Content="Clear Sort"
                    Height="28"
                    MinWidth="90"
                    DockPanel.Dock="Left"
                    Click="clear_clicked"/>
            <Button x:Name="cancel_b"
                    Content="Cancel"
                    IsCancel="True"
                    Height="28"
                    MinWidth="90"
                    DockPanel.Dock="Right"
                    Click="cancel_clicked"/>
            <Button x:Name="ok_b"
                    Content="Apply Sort"
                    IsDefault="True"
                    Height="28"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    DockPanel.Dock="Right"
                    Click="ok_clicked"/>
        </DockPanel>
    </Grid>
</Window>
