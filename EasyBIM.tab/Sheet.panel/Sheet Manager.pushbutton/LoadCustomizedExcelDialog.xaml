<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Customized Excel"
        Height="680"
        Width="1160"
        MinHeight="540"
        MinWidth="960"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ComparisonText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Load sheets from a customized Excel file" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="The first visible worksheet and its first two visible columns are read as sheet number and sheet name. No header row is skipped."
                       Margin="0,5,0,0" Foreground="DimGray" TextWrapping="Wrap"/>
            <TextBlock x:Name="file_tb" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="warning_tb" Margin="0,5,0,0" Foreground="#A15C00"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Compare Excel with:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="comparison_source_cb" Grid.Column="1" MinHeight="30"
                          SelectionChanged="comparison_source_changed"/>
                <Button x:Name="compare_b" Grid.Column="2" Content="Compare…" MinWidth="105"
                        Height="32" Margin="8,0,0,0" Click="compare_clicked"/>
            </Grid>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Load uses Import &amp; Resolve. Comparison never changes either source."
                       Foreground="DimGray" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="load_b" Grid.Column="1" Height="32" MinWidth="90" Margin="12,0,8,0"
                    Content="Load" IsDefault="True" Click="load_clicked"/>
            <Button x:Name="cancel_b" Grid.Column="2" Height="32" MinWidth="90"
                    Content="Cancel" IsCancel="True" Click="cancel_clicked"/>
        </Grid>

        <TabControl Margin="0,12,0,0">
        <TabItem Header="Import &amp; Resolve">
        <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="summary_tb" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Border x:Name="errormsg_block" Background="#C00000" Padding="5"
                        Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="errormsg_tb" Foreground="White" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Missing / Duplicate Sheet Numbers"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Sheet Names Discrepancy"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="number_discrepancies_dg" Grid.Row="0"
                          AutoGenerateColumns="False" BorderThickness="1" RowHeaderWidth="0"
                          CanUserSortColumns="False" Foreground="#C00000"
                          HorizontalGridLinesBrush="#DEDEDE" VerticalGridLinesBrush="#DEDEDE">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding is_selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Excel Row" Binding="{Binding excel_row}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sheet Number" Binding="{Binding number}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sheet Name" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding reason}" Width="150" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="create_selected_b" Height="32" MinWidth="180"
                            Content="Create Selected Sheets" Click="create_selected_sheets"/>
                    <Button x:Name="skip_numbers_b" Height="32" MinWidth="130" Margin="8,0,0,0"
                            Content="Skip and Ignore" Click="skip_selected_numbers"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="name_discrepancies_dg" Grid.Row="0"
                          AutoGenerateColumns="False" BorderThickness="1" RowHeaderWidth="0"
                          CanUserSortColumns="False" Foreground="#C00000"
                          HorizontalGridLinesBrush="#DEDEDE" VerticalGridLinesBrush="#DEDEDE">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding is_selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Excel Row" Binding="{Binding excel_row}" Width="65" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sheet Number" Binding="{Binding number}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sheet Name (Excel)" Binding="{Binding excel_name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sheet Name (Revit)" Binding="{Binding revit_name}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="rename_selected_b" Height="32" MinWidth="180"
                            Content="Rename to Match Excel" Click="rename_selected_sheets"/>
                    <Button x:Name="skip_names_b" Height="32" MinWidth="130" Margin="8,0,0,0"
                            Content="Skip and Ignore" Click="skip_selected_names"/>
                </StackPanel>
            </Grid>
        </Grid>
        </DockPanel>
        </TabItem>
        <TabItem x:Name="comparison_tab" Header="Comparison">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Read-only comparison of the original visible Excel rows (including ignored/staged rows) with the selected Revit source."
                               Foreground="DimGray" TextWrapping="Wrap"/>
                    <TextBlock Text="Grouped by reason priority, then sheet number. Multiple verified reasons appear together in Details."
                               Foreground="DimGray" TextWrapping="Wrap"/>
                    <TextBlock x:Name="comparison_summary_tb" Text="Choose a Sheet List or Print Set, then click Compare."
                               Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="comparison_warning_tb" Foreground="#A15C00" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <DataGrid x:Name="comparison_dg" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          RowHeaderWidth="0" HeadersVisibility="Column" BorderThickness="1"
                          HorizontalGridLinesBrush="#DEDEDE" VerticalGridLinesBrush="#DEDEDE"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#E3ECF5" BorderBrush="#B7CADD" BorderThickness="0,1,0,1"
                                            Padding="8,7" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#243C54"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" FontWeight="SemiBold" Foreground="#243C54"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sheet Number" Binding="{Binding number}" Width="105" ElementStyle="{StaticResource ComparisonText}"/>
                        <DataGridTextColumn Header="Sheet Name (Excel)" Binding="{Binding excel_name}" Width="1.2*" ElementStyle="{StaticResource ComparisonText}"/>
                        <DataGridTextColumn Header="Sheet Name (Revit)" Binding="{Binding revit_name}" Width="1.2*" ElementStyle="{StaticResource ComparisonText}"/>
                        <DataGridTextColumn Header="Excel Row" Binding="{Binding excel_rows}" Width="75" ElementStyle="{StaticResource ComparisonText}"/>
                        <DataGridTextColumn Header="Revit Position" Binding="{Binding source_positions}" Width="95" ElementStyle="{StaticResource ComparisonText}"/>
                        <DataGridTextColumn Header="Reason / Details" Binding="{Binding details}" Width="2*" ElementStyle="{StaticResource ComparisonText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
