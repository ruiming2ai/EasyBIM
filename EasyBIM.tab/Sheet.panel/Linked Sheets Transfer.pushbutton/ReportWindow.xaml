<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linked Sheets Transfer - Report"
        Width="820"
        Height="620"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText"
                           FontFamily="Consolas"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="OpenSheetButton"
                    Content="Open the first sheet"
                    Width="180"
                    Height="34"
                    Margin="0,0,8,0"
                    ToolTipService.ShowOnDisabled="True"
                    Click="open_sheet_click" />
            <Button Content="Close"
                    Width="110"
                    Height="34"
                    IsDefault="True"
                    IsCancel="True"
                    Click="close_click" />
        </StackPanel>
    </Grid>
</Window>
