<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyBIM | e-transmit" Width="900" Height="840" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#F6F7F9">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,3,6,3"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="3,5"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/></Style>
  </Window.Resources>
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="e-transmit" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock x:Name="VersionLabel" Foreground="#536273"/>
      <TextBlock Text="Open models: saved local/cache state only. Unsaved edits are excluded unless you explicitly choose detached-model Save As recovery. Saving and temporary link reloads require your choice. No Sync or Publish."
                 TextWrapping="Wrap" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock Text="ACC live models must be opened first through Revit Home → Autodesk Docs. EasyBIM uses the live cloud model currently loaded by Revit and does not substitute a published ACC version."
                 TextWrapping="Wrap" Foreground="#536273" Margin="0,7,0,7"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Transmit saved copies" Click="transmit_click" MinWidth="165" IsDefault="True"/>
        <Button Content="Cancel" Click="cancel_click" IsCancel="True" MinWidth="95"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <GroupBox Header="1  Source model(s)">
          <StackPanel>
            <DataGrid x:Name="Models" Height="155" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="190" IsReadOnly="True"/>
                <DataGridTextColumn Header="Source mode" Binding="{Binding Mode}" Width="145" IsReadOnly="True"/>
                <DataGridTextColumn Header="Original path / selected version" Binding="{Binding Source}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel>
              <Button Content="Browse models..." Click="browse_models"/>
              <Button Content="Browse folder..." Click="browse_model_folder"/>
              <Button Content="Remove selected" Click="remove_model"/>
            </WrapPanel>
            <TextBlock Text="The active project is checked by default. For live ACC cloud-workshared models, open the model first in native Revit Home → Autodesk Docs, then select the open row here. Open rows use saved local/cache state; unsaved edits are excluded unless detached-model recovery explicitly saves the current state. Browse selects saved local RVTs." TextWrapping="Wrap" Foreground="#536273"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="2  Destination and collection">
          <StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse..." Click="browse_output"/><TextBox x:Name="Output"/></DockPanel>
            <WrapPanel>
              <TextBlock Text="Each host gets an independent model-named package with its own Links folder." TextWrapping="Wrap"/>
              <CheckBox x:Name="Reports" Content="Detailed transmittal/error reports" IsChecked="True"/>
              <CheckBox x:Name="ZipPerModel" Content="Create a separate ZIP for each model"/>
              <CheckBox x:Name="Zip" Content="Also ZIP the entire batch"/>
            </WrapPanel>
            <TextBlock Text="Repath off: no host reopening unless Cleanup or Upgrade is selected. Unloaded links are offered in a separate selection window." TextWrapping="Wrap" Foreground="#536273"/>
            <CheckBox x:Name="Repath" Content="Repath supported references in package copies; report manual repairs" IsChecked="True"/>
            <CheckBox x:Name="SimpleRepath" Content="Simple copy and repath (native file links)" IsChecked="True"/>
            <TextBlock Text="Simple mode keeps the saved host/cache copy and repaths native file links. PDFs/images and ACC resource links may need manual repair. Uncheck for automatic Revit repairs. Cleanup or Upgrade also requires Revit processing." TextWrapping="Wrap" Foreground="#536273"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="File Structure Organization">
          <StackPanel>
            <ComboBox x:Name="FileStructure" DisplayMemberPath="Name" Margin="0,5"/>
            <TextBlock Text="One copy per source in Links. Same-name files use separate subfolders; filenames stay unchanged. Required support folders stay together in every mode." TextWrapping="Wrap" Foreground="#536273"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="3  Related files — all included by default">
          <StackPanel>
            <ItemsControl x:Name="Categories">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><CheckBox Width="245" Content="{Binding Name}" IsChecked="{Binding Checked, Mode=TwoWay}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Imports are not extracted. Plugin spreadsheet collection does not reconnect private plugin links; restricted schemas are reported. CAD Xrefs, RCP scans outside the Support folder, and NWF dependencies need verification; add any extra files/folders below." TextWrapping="Wrap" Foreground="#536273"/>
            <WrapPanel><Button Content="Add files..." Click="add_files"/><Button Content="Add folder..." Click="add_folder"/><Button Content="Remove extra" Click="remove_extra"/></WrapPanel>
            <ListBox x:Name="Extras" Height="70"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="4  Upgrade and cleanup — package copies only">
          <StackPanel>
            <CheckBox x:Name="Upgrade" Content="Upgrade package models to this running Revit version"/>
            <CheckBox x:Name="Cleanup" Content="Enable cleanup (older package models will also be upgraded)" Click="cleanup_toggle"/>
            <StackPanel x:Name="CleanupOptions" IsEnabled="False" Margin="18,0,0,0">
              <CheckBox x:Name="DiscardWorksets" Content="Disable worksets / remove worksharing"/>
              <CheckBox x:Name="Purge" Content="Purge unused definitions (requires GetUnusedElements API)"/>
              <ComboBox x:Name="ViewMode" DisplayMemberPath="Name" Margin="0,5"/>
              <Button Content="Select view types to retain..." Click="select_view_types" HorizontalAlignment="Left"/>
              <TextBlock x:Name="ViewTypesLabel" Text="No additional view types selected" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="SaveSettings" Content="Remember destination and collection preferences (not destructive cleanup settings)" IsChecked="True"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
