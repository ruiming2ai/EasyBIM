<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Ribbon - Sign in"
        Width="500"
        Height="300"
        MinWidth="440"
        MinHeight="280"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="The repository needs a sign-in" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="message_tb" Margin="0,6,0,0" FontSize="12" Foreground="DimGray" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="User name" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="UserBox" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Token / password" VerticalAlignment="Center" Margin="0,10,12,0"/>
            <PasswordBox x:Name="TokenBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" FontSize="11" Foreground="DimGray" TextWrapping="Wrap"
                       Text="Used once for this download and kept only until Revit closes. GitHub wants a personal access token here, not your account password."/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Try again" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="ok_click"/>
            <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
        </StackPanel>
    </Grid>
</Window>
