<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Project Files"
        Width="780"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Select Project Files" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Families are read straight out of these files - none of them opens in a tab, and nothing is ever written back. A file saved in an older Revit is upgraded in memory only; one saved in a newer Revit cannot be read at all."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="file_count_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="add_files_btn" Content="Add Files..." Width="120" Height="30"
                        Margin="8,0,0,0" Click="add_files_click"/>
                <TextBlock DockPanel.Dock="Left" Text="Search files" FontSize="11" FontWeight="SemiBold"
                           Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FileSearchBox" Height="28" VerticalAlignment="Center" TextChanged="file_search_changed"/>
            </DockPanel>

            <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FileListPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Select All" Width="100" Height="34" Margin="0,0,8,0" Click="file_select_all_click"/>
                    <Button Content="Select None" Width="100" Height="34" Click="file_select_none_click"/>
                    <CheckBox x:Name="hide_unchecked_cb" Content="Hide Un-checked" VerticalAlignment="Center"
                              Margin="12,0,0,0" Click="hide_unchecked_click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                    <Button Content="Next" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="next_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
