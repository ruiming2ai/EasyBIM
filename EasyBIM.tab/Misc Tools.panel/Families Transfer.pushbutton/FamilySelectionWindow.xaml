<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transferable Families"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="header_tb" Text="Transferable Families" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="count_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="pick_more_btn" Content="Select in the model" Width="150" Height="30" Margin="0,0,8,0" Click="pick_more_click"/>
                        <Button Content="Expand All" Width="100" Height="30" Margin="0,0,8,0" Click="expand_all_click"/>
                        <Button Content="Collapse All" Width="110" Height="30" Click="collapse_all_click"/>
                    </StackPanel>
                    <TextBlock Text="Search families" FontSize="11" FontWeight="SemiBold" Foreground="DimGray" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="FamilySearchBox" Height="28" Margin="0,4,0,0" TextChanged="family_search_changed"/>
            </Grid>

            <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" MinHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FamilyListPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Select All" Width="100" Height="34" Margin="0,0,8,0" Click="select_all_click"/>
                    <Button Content="Select None" Width="100" Height="34" Click="select_none_click"/>
                    <CheckBox x:Name="hide_unchecked_cb" Content="Hide Un-checked" VerticalAlignment="Center"
                              Margin="12,0,0,0" Click="hide_unchecked_click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                    <Button Content="Add" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="add_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
