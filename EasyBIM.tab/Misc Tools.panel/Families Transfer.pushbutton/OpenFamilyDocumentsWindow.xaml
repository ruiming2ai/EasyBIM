<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Opened .rfa files"
        Width="660"
        Height="620"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Add Opened .rfa files" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="count_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="OpenFamilyListPanel"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Select All" Width="100" Height="34" Margin="0,0,8,0" Click="select_all_click"/>
                    <Button Content="Select None" Width="100" Height="34" Click="select_none_click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                    <Button Content="Next" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="next_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
