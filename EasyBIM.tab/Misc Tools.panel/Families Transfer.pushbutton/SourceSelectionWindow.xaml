<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Families Transfer"
        Width="820"
        Height="1000"
        MinWidth="760"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="596"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Families Transfer" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Collect families from this project, from opened .rfa files, and from Revit links."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Every star row carries a MinHeight. An unconstrained star row shrinks
             to zero and paints its child outside the cell, which is what let the
             first two cards eat their own headers when the window was dragged
             short. Inside each card only the list row flexes, so dragging the
             window resizes the three lists and moves nothing else. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="load_more_btn" Content="Load More from Recent Project" Width="220" Height="30" Margin="8,0,8,0" Click="load_more_click"/>
                            <Button Content="Select All" Width="90" Height="30" Margin="0,0,8,0" Click="selected_source_select_all_click"/>
                            <Button Content="Select None" Width="90" Height="30" Click="selected_source_select_none_click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Selection from Recent Project" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="selected_count_tb" Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,8,0,6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="11" FontWeight="SemiBold" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SelectedSourceSearchBox" Height="28" VerticalAlignment="Center" TextChanged="selected_source_search_changed"/>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SelectedSourceListPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Select All" Width="90" Height="30" Margin="8,0,8,0" Click="open_family_select_all_click"/>
                            <Button Content="Select None" Width="90" Height="30" Click="open_family_select_none_click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Add Opened .rfa Files" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="open_rfa_count_tb" Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,8,0,6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="11" FontWeight="SemiBold" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="OpenFamilySearchBox" Height="28" VerticalAlignment="Center" TextChanged="open_family_search_changed"/>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OpenFamilyListPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="load_file_families_btn" Content="Load More from Project Files" Width="220" Height="30" Margin="8,0,8,0" Click="load_file_families_click"/>
                            <Button Content="Select All" Width="90" Height="30" Margin="0,0,8,0" Click="file_family_select_all_click"/>
                            <Button Content="Select None" Width="90" Height="30" Click="file_family_select_none_click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Selection from Unopened Project Files" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="file_family_count_tb" Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,8,0,6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="11" FontWeight="SemiBold" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FileFamilySearchBox" Height="28" VerticalAlignment="Center" TextChanged="file_family_search_changed"/>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="FileFamilyListPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="6" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="load_link_families_btn" Content="Load More from Revit Links" Width="220" Height="30" Margin="8,0,8,0" Click="load_link_families_click"/>
                            <Button Content="Select All" Width="90" Height="30" Margin="0,0,8,0" Click="link_family_select_all_click"/>
                            <Button Content="Select None" Width="90" Height="30" Click="link_family_select_none_click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Selection from Revit Links" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="link_family_count_tb" Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,8,0,6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="11" FontWeight="SemiBold" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="LinkFamilySearchBox" Height="28" VerticalAlignment="Center" TextChanged="link_family_search_changed"/>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LinkFamilyListPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Trimmed, never wrapped: a two-line status grows this Auto row
                     and pushes the body past the bottom of the window. -->
                <TextBlock x:Name="status_tb" Grid.Column="0" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Next" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="next_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
