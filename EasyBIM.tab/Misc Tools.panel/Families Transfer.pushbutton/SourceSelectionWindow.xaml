<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Families Transfer"
        Width="560"
        Height="360"
        MinWidth="500"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Families Transfer" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Start with the families already selected in the model, or select more family instances before choosing what to transfer."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Selection Source" FontSize="11" FontWeight="SemiBold" Foreground="DimGray"/>
                <TextBlock x:Name="selected_count_tb" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12"/>
                <Button x:Name="select_btn" Content="Select More Families" Width="180" Height="36" HorizontalAlignment="Left" Click="select_click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="status_tb" Grid.Column="0" VerticalAlignment="Center" Foreground="DimGray" TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Next" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="next_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
