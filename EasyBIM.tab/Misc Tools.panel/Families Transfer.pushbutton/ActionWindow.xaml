<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Families Transfer"
        Width="560"
        Height="340"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Families Transfer" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Choose whether to export family files or load the selected families directly into checked open files."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="14">
            <TextBlock x:Name="summary_tb" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export" Width="110" Height="36" Margin="0,0,8,0" Click="export_click"/>
                <Button Content="Transfer" Width="110" Height="36" Margin="0,0,8,0" IsDefault="True" Click="transfer_click"/>
                <Button Content="Cancel" Width="110" Height="36" IsCancel="True" Click="cancel_click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
