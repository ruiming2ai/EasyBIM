<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Monitor - Review Changes" Width="1120" Height="720"
        MinWidth="800" MinHeight="520" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FilterBox" Width="220" SelectionChanged="filter_changed"/>
            <Button Content="Select visible" Margin="12,0,6,0" Padding="10,4" Click="select_visible"/>
            <Button Content="Clear selection" Padding="10,4" Click="clear_selection"/>
            <Button Content="Check Changes" Margin="12,0,0,0" Padding="10,4" Click="refresh_click"/>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="IssuesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionChanged="selection_changed" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Apply" Width="50" Binding="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Status" Width="145" Binding="{Binding Status}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Link" Width="150" Binding="{Binding Link}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Family" Width="*" Binding="{Binding Family}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Width="130" Binding="{Binding Type}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Source ID" Width="85" Binding="{Binding Source}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Local ID" Width="85" Binding="{Binding Destination}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Grid.Row="3" x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,10"/>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button Content="Show local" Padding="10,6" Margin="4" Click="show_click"/>
            <Button Content="Match Source" Padding="10,6" Margin="4" Click="match_click"/>
            <Button Content="Keep Relative Location" Padding="10,6" Margin="4" Click="relative_click"/>
            <Button Content="Accept Difference" Padding="10,6" Margin="4" Click="accept_click"/>
            <Button Content="Postpone" Padding="10,6" Margin="4" Click="postpone_click"/>
            <Button Content="Stop Monitoring" Padding="10,6" Margin="4" Click="stop_click"/>
            <Button Content="Close" Padding="10,6" Margin="4" IsCancel="True" Click="close_click"/>
        </WrapPanel>
    </Grid>
</Window>
