<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Damper Check"
        Width="820"
        Height="720"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Damper Check"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       Text="Read-only. Every air terminal is traced back through the physical duct connections to its nearest damper - or to the equipment, an open end, or nothing at all. Nothing in the model is changed." />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Scope"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <RadioButton x:Name="ScopeModelRadio"
                                 GroupName="DamperCheckScope"
                                 Content="Whole model"
                                 IsChecked="True"
                                 Margin="0,2,0,2"
                                 Checked="scope_changed" />
                    <RadioButton x:Name="ScopeViewRadio"
                                 GroupName="DamperCheckScope"
                                 Content="Air terminals in the active view"
                                 Margin="0,2,0,2"
                                 ToolTipService.ShowOnDisabled="True"
                                 Checked="scope_changed" />
                    <TextBlock x:Name="ScopeHintText"
                               Foreground="DimGray"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"
                               Text="The walk always follows the whole model's ducts, so a branch that leaves the view is still traced to its damper; only which terminals are reported changes." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Duct system classes"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <WrapPanel>
                        <CheckBox x:Name="SupplyCheck" Content="Supply" IsChecked="True" Margin="0,2,14,2" Checked="chip_changed" Unchecked="chip_changed" />
                        <CheckBox x:Name="ReturnCheck" Content="Return" IsChecked="True" Margin="0,2,14,2" Checked="chip_changed" Unchecked="chip_changed" />
                        <CheckBox x:Name="ExhaustCheck" Content="Exhaust" IsChecked="True" Margin="0,2,14,2" Checked="chip_changed" Unchecked="chip_changed" />
                        <CheckBox x:Name="OtherCheck" Content="Other" IsChecked="True" Margin="0,2,14,2" Checked="chip_changed" Unchecked="chip_changed" />
                        <CheckBox x:Name="UnknownCheck" Content="Unknown / no system" IsChecked="True" Margin="0,2,14,2" Checked="chip_changed" Unchecked="chip_changed" />
                    </WrapPanel>
                    <TextBlock Foreground="DimGray"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Text="Read from each terminal's own system type, which exists whether or not a system was ever assigned. A class left unticked is named in the report's footer, never silently absent." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Which family types count as dampers"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TypeAllButton"
                                Content="Select All"
                                Width="90"
                                Height="26"
                                Margin="0,0,6,0"
                                Click="type_all_click" />
                        <Button x:Name="TypeNoneButton"
                                Content="Select None"
                                Width="90"
                                Height="26"
                                Click="type_none_click" />
                    </StackPanel>
                    <TextBlock x:Name="TypeCountText"
                               Foreground="DimGray"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               Text="0 of 0 types ticked as dampers." />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,8,0,6" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Search"
                               Foreground="DimGray"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="TypeSearchBox"
                             Height="24"
                             VerticalContentAlignment="Center"
                             TextChanged="type_search_changed" />
                </DockPanel>

                <Border Grid.Row="2"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TypePanel" Margin="6" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#E3E3E3"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="10"
                Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="One damper may serve up to"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="ThresholdBox"
                             Width="56"
                             Height="24"
                             Margin="8,0,8,0"
                             Text="1"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextChanged="threshold_changed" />
                    <TextBlock Text="terminal(s)."
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Foreground="DimGray"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="1 means every terminal needs its own damper before the first junction that serves another terminal. A higher number lets one damper cover a small sub-branch. You can change it live in the report without rescanning." />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4"
                   LastChildFill="False"
                   Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       MaxWidth="440"
                       Text="Keywords only pre-tick the list; your ticks are remembered by family and type name on this computer." />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="110"
                    Height="34"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="cancel_click" />
            <Button x:Name="CheckButton"
                    Content="Check"
                    Width="110"
                    Height="34"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    Click="check_click" />
        </DockPanel>
    </Grid>
</Window>
