<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Damper Check"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Damper Check"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Text="Every air terminal in scope, by what its walk toward the trunk found. Show selects the run in the model. Nothing is ever changed." />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,14,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Search"
                               Foreground="DimGray"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox"
                             Height="26"
                             VerticalContentAlignment="Center"
                             ToolTip="Ids match whole (12 does not find 112); names by substring."
                             TextChanged="search_changed" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="One damper may serve up to"
                               VerticalAlignment="Center" />
                    <Button x:Name="ThresholdDownButton"
                            Content="-"
                            Width="26"
                            Height="26"
                            Margin="8,0,0,0"
                            Click="threshold_down_click" />
                    <TextBox x:Name="ThresholdBox"
                             Width="52"
                             Height="26"
                             Text="1"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextChanged="threshold_changed" />
                    <Button x:Name="ThresholdUpButton"
                            Content="+"
                            Width="26"
                            Height="26"
                            Click="threshold_up_click" />
                    <TextBlock Text="terminal(s)"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="12">
            <Grid>
                <TextBlock x:Name="EmptyText"
                           Visibility="Collapsed"
                           Foreground="DimGray"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="Refresh" Width="110" Height="36" Margin="0,0,8,0" ToolTip="Re-read the model; search, limit and expanded groups survive." Click="refresh_click" />
                    <Button x:Name="ExpandAllButton" Content="Expand All" Width="110" Height="36" Margin="0,0,8,0" Click="expand_all_click" />
                    <Button x:Name="CollapseAllButton" Content="Collapse All" Width="110" Height="36" Margin="0,0,8,0" Click="collapse_all_click" />
                    <Button x:Name="CloseButton" Content="Close" Width="110" Height="36" IsCancel="True" Click="close_click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
