<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offset"
        Width="440"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   x:Name="UnitTextBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   Text="Hand / Local X"
                   VerticalAlignment="Center" />
        <TextBox x:Name="XOffsetTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Text="0"
                 Margin="0,0,0,8" />

        <TextBlock Grid.Row="2"
                   Text="Facing / Local Y"
                   VerticalAlignment="Center" />
        <TextBox x:Name="YOffsetTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Text="0"
                 Margin="0,0,0,8" />

        <TextBlock Grid.Row="3"
                   Text="Up / Local Z"
                   VerticalAlignment="Center" />
        <TextBox x:Name="ZOffsetTextBox"
                 Grid.Row="3"
                 Grid.Column="1"
                 Text="0"
                 Margin="0,0,0,12" />

        <CheckBox x:Name="AlignOrientationCheckBox"
                  Grid.Row="4"
                  Grid.ColumnSpan="2"
                  Content="Align Orientation"
                  IsChecked="True"
                  Margin="0,0,0,6" />

        <TextBlock Grid.Row="5"
                   Grid.ColumnSpan="2"
                   Text="Checked: source-to-target orientation alignment (v1.0.3). Unchecked: translation-only placement (v1.0.2)."
                   Foreground="DimGray"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Back"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="back_click" />
            <Button Content="Run"
                    Width="88"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="run_click" />
            <Button Content="Cancel"
                    Width="88"
                    IsCancel="True"
                    Click="cancel_click" />
        </StackPanel>
    </Grid>
</Window>
