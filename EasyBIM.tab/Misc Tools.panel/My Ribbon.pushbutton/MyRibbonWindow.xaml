<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Ribbon"
        Width="1040"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="380"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="My Ribbon" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Pick buttons from other pyRevit extensions, Revit's own tabs, other add-ins or Dynamo graphs, and put them on panels of your own. Updates come from pyRevit ▸ Update (and EasyBIM Auto Update); Apply closes this window."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Every star row/column carries a MinHeight/MinWidth: an
             unconstrained star shrinks to zero and paints its child outside
             the cell when the window is dragged short. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="330"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*" MinWidth="440"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Add source..." Width="120" Height="30" Margin="8,0,0,0" VerticalAlignment="Top" Click="add_source_click"/>
                        <StackPanel>
                            <TextBlock Text="Sources" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="sources_count_tb" Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Margin="0,8,0,8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="4">
                        <ListBox x:Name="SourcesList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 SelectionChanged="sources_selection_changed"/>
                    </Border>

                    <!-- A WrapPanel: five buttons do not fit the column at its
                         minimum width, and a clipped button is worse than a
                         second row. -->
                    <WrapPanel Grid.Row="2">
                        <Button x:Name="remove_source_btn" Content="Remove" Width="80" Height="30" Margin="0,0,8,4" IsEnabled="False" Click="remove_source_click"
                                ToolTip="Forget this source and its placed buttons. Files stay."/>
                        <Button x:Name="uninstall_btn" Content="Uninstall" Width="80" Height="30" Margin="0,0,8,4" IsEnabled="False" Click="uninstall_source_click"
                                ToolTip="Remove it and delete the files My Ribbon installed for it (on Apply)."/>
                        <Button x:Name="open_folder_btn" Content="Open folder" Width="95" Height="30" Margin="0,0,8,4" IsEnabled="False" Click="open_folder_click"/>
                        <Button x:Name="locate_btn" Content="Locate graph..." Width="110" Height="30" Margin="0,0,8,4" Visibility="Collapsed" Click="locate_click"
                                ToolTip="Point this Dynamo button at the graph file again (moved or renamed)."/>
                        <Button x:Name="add_buttons_btn" Content="Add buttons from it..." Width="150" Height="30" Margin="0,0,0,4" IsEnabled="False" Click="add_buttons_click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Show/Hide tabs..." Width="125" Height="30" Margin="8,0,8,0" Click="show_hide_tabs_click"
                                    ToolTip="Choose which ribbon tabs are visible. EasyBIM and Modify always stay."/>
                            <Button Content="New panel..." Width="100" Height="30" Margin="0,0,8,0" Click="new_panel_click"/>
                            <Button Content="New tab..." Width="90" Height="30" Click="new_tab_click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="My buttons" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="buttons_count_tb" Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Margin="0,8,0,8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="4">
                        <TreeView x:Name="ButtonsTree" BorderThickness="0" SelectedItemChanged="tree_selection_changed"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="move_up_btn" Content="Up" Width="60" Height="30" Margin="0,0,8,0" IsEnabled="False" Click="move_up_click"/>
                        <Button x:Name="move_down_btn" Content="Down" Width="60" Height="30" Margin="0,0,8,0" IsEnabled="False" Click="move_down_click"/>
                        <Button x:Name="move_to_btn" Content="Move to..." Width="90" Height="30" Margin="0,0,8,0" IsEnabled="False" Click="move_to_click"/>
                        <Button x:Name="rename_btn" Content="Rename..." Width="90" Height="30" Margin="0,0,8,0" IsEnabled="False" Click="rename_click"/>
                        <Button x:Name="remove_placement_btn" Content="Remove" Width="90" Height="30" IsEnabled="False" Click="remove_placement_click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Trimmed, never wrapped: a two-line status grows this Auto row. -->
                <TextBlock x:Name="status_tb" Grid.Column="0" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Import..." Width="100" Height="34" Margin="0,0,8,0" Click="import_click"/>
                    <Button Content="Export..." Width="100" Height="34" Margin="0,0,20,0" Click="export_click"/>
                    <Button x:Name="apply_btn" Content="Apply" Width="110" Height="34" Margin="0,0,8,0" IsDefault="True" Click="apply_click"/>
                    <Button Content="Close" Width="100" Height="34" Click="close_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
