<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Ribbon - Import"
        Width="640"
        Height="520"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Import settings" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="file_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <RadioButton x:Name="merge_radio" Content="Merge into what I have (keeps my current sources and buttons)" IsChecked="True" Checked="mode_changed"/>
                <RadioButton x:Name="replace_radio" Content="Replace everything with the file" Margin="0,8,0,0" Checked="mode_changed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="preview_tb" TextWrapping="Wrap" FontSize="13"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Import" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="import_click"/>
                <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
