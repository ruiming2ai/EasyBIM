<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebuild Families from Downgrade Packages"
        Width="820"
        Height="720"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Rebuild Families from Downgrade Packages" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="host_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Package folder" FontSize="15" FontWeight="SemiBold"/>
                <DockPanel LastChildFill="True" Margin="0,6,0,0">
                    <Button x:Name="browse_packages_btn" DockPanel.Dock="Right" Content="Browse..." Width="100" Height="30" Margin="8,0,0,0" Click="browse_packages_click"/>
                    <TextBox x:Name="package_folder_box" Height="30" VerticalContentAlignment="Center" FontSize="13" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock Text="Packages" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Select All" Width="100" Height="30" Margin="0,0,8,0" Click="select_all_click"/>
                        <Button Content="Select None" Width="100" Height="30" Click="select_none_click"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PackageListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Output folder for the rebuilt .rfa files" FontSize="15" FontWeight="SemiBold"/>
                <DockPanel LastChildFill="True" Margin="0,6,0,0">
                    <Button x:Name="browse_output_btn" DockPanel.Dock="Right" Content="Browse..." Width="100" Height="30" Margin="8,0,0,0" Click="browse_output_click"/>
                    <TextBox x:Name="output_folder_box" Height="30" VerticalContentAlignment="Center" FontSize="13"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="count_tb" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                    <Button Content="Rebuild" Width="110" Height="34" Margin="0,0,8,0" IsDefault="True" Click="rebuild_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
