<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Specify Types"
        Height="560"
        Width="720"
        MinHeight="380"
        MinWidth="560"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Specify Types" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="file_tb"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="DimGray"
                       TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Text="Types are matched by name, the way a type catalogue matches them. A name this family does not have becomes a new type - rename a type in the table instead of in the spreadsheet. Nothing is written to the family until you click Apply Changes."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <WrapPanel.Resources>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Margin" Value="0,0,6,4"/>
                    <Setter Property="Padding" Value="10,0,10,0"/>
                </Style>
            </WrapPanel.Resources>
            <Button x:Name="all_b" Content="All" Click="select_all_clicked"/>
            <Button x:Name="none_b" Content="None" Click="select_none_clicked"/>
            <Button x:Name="newonly_b" Content="New Only" Click="select_new_clicked"/>
        </WrapPanel>

        <DataGrid x:Name="entries_dg"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  RowHeaderWidth="0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  HorizontalGridLinesBrush="#dedede"
                  VerticalGridLinesBrush="#dedede"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="52">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="Use" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding can_select}"
                                      IsChecked="{Binding is_selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Family Type"
                                    Binding="{Binding type_name}"
                                    Width="240"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding status}"
                                    Width="110"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="What the file changes"
                                    Binding="{Binding change_text}"
                                    Width="*"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <CheckBox x:Name="deletemissing_cb"
                      Content="Delete family types that are not in the file"
                      ToolTip="Off by default. Ticking it marks every type missing from the workbook for deletion; you still see them struck through before Apply."/>
            <TextBlock x:Name="warn_tb"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="#B25000"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="count_tb"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"/>
            <Button x:Name="cancel_b"
                    Content="Cancel"
                    DockPanel.Dock="Right"
                    Height="30"
                    MinWidth="100"
                    IsCancel="True"
                    Click="cancel_clicked"/>
            <Button x:Name="import_b"
                    Content="Import"
                    DockPanel.Dock="Right"
                    Height="30"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    FontWeight="SemiBold"
                    Click="import_clicked"/>
        </DockPanel>
    </Grid>
</Window>
