<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Align - Report"
        Width="700"
        Height="560"
        MinWidth="600"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText"
                           FontFamily="Consolas"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SelectSkippedButton"
                    Grid.Column="0"
                    Content="Select skipped elements"
                    Height="34"
                    Padding="12,0,12,0"
                    IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Nothing was skipped."
                    Click="select_skipped_click" />

            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Content="Close"
                    Width="100"
                    Height="34"
                    IsDefault="True"
                    IsCancel="True"
                    Click="close_click" />
        </Grid>
    </Grid>
</Window>
