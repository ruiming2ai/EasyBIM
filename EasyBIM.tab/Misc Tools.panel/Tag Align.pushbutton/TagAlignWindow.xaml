<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Align"
        Width="840"
        Height="760"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Tag Align"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       Text="Copy one tag's placement onto other elements. Pick a reference tag first - everything else stays greyed out until you do." />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="SelectOneButton"
                            Content="Select One Reference Tag"
                            Width="200"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="select_one_click" />
                    <Button x:Name="SelectMultipleButton"
                            Content="Select Multiple Reference Tags"
                            Width="220"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="select_multiple_click" />
                    <Button x:Name="UseSelectionButton"
                            Content="Use current selection"
                            Height="34"
                            Padding="12,0,12,0"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="use_selection_click" />
                    <Button x:Name="ClearReferencesButton"
                            Content="Clear"
                            Width="90"
                            Height="34"
                            IsEnabled="False"
                            Click="clear_references_click" />
                </StackPanel>

                <TextBlock x:Name="ReferenceSummaryText"
                           Grid.Row="1"
                           Margin="0,10,0,0"
                           Foreground="DimGray"
                           TextWrapping="Wrap"
                           Text="No reference tag selected yet." />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Reference tags"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReferenceListPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="ScopeBorder"
                Grid.Row="3"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0"
                IsEnabled="False"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="Select a reference tag first.">
            <StackPanel>
                <TextBlock Text="Apply the reference to"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <RadioButton x:Name="ScopeCategoryRadio"
                             GroupName="TagAlignScope"
                             Content="All the families in the same category"
                             IsChecked="True"
                             Margin="0,2,0,2"
                             Checked="scope_changed" />
                <RadioButton x:Name="ScopePairedRadio"
                             GroupName="TagAlignScope"
                             Content="Apply to different types, but only paired family"
                             Margin="0,2,0,2"
                             Checked="scope_changed" />
                <RadioButton x:Name="ScopeExactRadio"
                             GroupName="TagAlignScope"
                             Content="Exact same family and type match only"
                             Margin="0,2,0,2"
                             Checked="scope_changed" />
                <TextBlock Foreground="DimGray"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="22,6,0,0"
                           Text="A different category is never matched. The closest reference always wins - one on the element's own type beats one on a sibling type, which beats one from another family - so a wider setting only ever adds a fallback. When two references would claim the same element at the same orientation, the conflict window asks which one wins." />
            </StackPanel>
        </Border>

        <Border x:Name="OptionsBorder"
                Grid.Row="4"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0"
                IsEnabled="False"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="Select a reference tag first.">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="ScaleWithViewCheck"
                              Content="Scale offset with view scale"
                              IsChecked="True"
                              Margin="0,2,0,2"
                              ToolTip="Keeps the printed distance the same when the target view has a different scale from the reference view."
                              Checked="option_changed"
                              Unchecked="option_changed" />
                    <CheckBox x:Name="CopyLeaderCheck"
                              Content="Copy leader settings from reference"
                              IsChecked="True"
                              Margin="0,2,0,2"
                              Checked="option_changed"
                              Unchecked="option_changed" />
                    <CheckBox x:Name="ChangeTagTypeCheck"
                              Content="Also change tag type to match reference"
                              Margin="0,2,0,2"
                              Checked="option_changed"
                              Unchecked="option_changed" />
                    <CheckBox x:Name="ConfirmBeforeProcessCheck"
                              Content="Confirm before processing a batch"
                              IsChecked="True"
                              Margin="0,2,0,2"
                              Checked="option_changed"
                              Unchecked="option_changed" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <CheckBox x:Name="IncludePinnedCheck"
                              Content="Include pinned tags"
                              Margin="0,2,0,2"
                              Checked="option_changed"
                              Unchecked="option_changed" />
                    <CheckBox x:Name="CollapseFlipCheck"
                              Content="Treat 180° flipped elements as the same orientation"
                              IsChecked="True"
                              Margin="0,2,0,2"
                              ToolTip="Only applies to elements whose direction comes from a location curve, where the axis has no front or back."
                              Checked="option_changed"
                              Unchecked="option_changed" />
                    <CheckBox x:Name="RotateFallbackCheck"
                              Content="Rotate the nearest reference for unmatched orientations"
                              Margin="0,2,0,2"
                              ToolTip="Off: an element at an orientation with no reference is skipped and reported."
                              Checked="option_changed"
                              Unchecked="option_changed" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HintText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#B06000"
                       TextWrapping="Wrap"
                       Text="Select a reference tag to enable Align and Align &amp; Tag." />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="AlignButton"
                        Content="Align"
                        Width="120"
                        Height="36"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Select a reference tag first."
                        Click="align_click" />
                <Button x:Name="AlignAndTagButton"
                        Content="Align &amp; Tag"
                        Width="120"
                        Height="36"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Select a reference tag first."
                        Click="align_and_tag_click" />
                <Button x:Name="CancelButton"
                        Content="Close"
                        Width="100"
                        Height="36"
                        IsCancel="True"
                        Click="cancel_click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
