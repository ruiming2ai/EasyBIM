<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Align - Batch"
        Width="720"
        Height="420"
        MinWidth="640"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FilterButton"
                        Content="Filter"
                        Width="90"
                        Height="32"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Narrow the current selection by category, family and type."
                        Click="filter_click" />
                <Button x:Name="SelectButton"
                        Content="Select"
                        Width="90"
                        Height="32"
                        Margin="0,0,8,0"
                        ToolTip="Add elements to the set with Revit's normal window or crossing selection."
                        Click="select_click" />
                <Button x:Name="DeselectButton"
                        Content="Deselect"
                        Width="90"
                        Height="32"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Remove elements from the set."
                        Click="deselect_click" />
                <Button x:Name="ClearButton"
                        Content="Clear"
                        Width="90"
                        Height="32"
                        Margin="0,0,20,0"
                        IsEnabled="False"
                        Click="clear_click" />
                <Button x:Name="ProcessButton"
                        Content="Process"
                        Width="110"
                        Height="32"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Select at least one element first."
                        Click="process_click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#E6E6E6"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="10"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="CountText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="0 element(s) selected." />
                <TextBlock x:Name="StatusText"
                           Foreground="DimGray"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="Press Select and cross-select the elements you want. The selection stays highlighted in Revit between steps." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Selection breakdown"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BreakdownPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="ReportButton"
                    Content="Show report"
                    Width="120"
                    Height="34"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="report_click" />
            <Button x:Name="BackButton"
                    Content="Back"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="back_click" />
            <Button x:Name="CancelButton"
                    Content="Close"
                    Width="100"
                    Height="34"
                    IsCancel="True"
                    Click="cancel_click" />
        </StackPanel>
    </Grid>
</Window>
