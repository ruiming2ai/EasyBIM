<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Align"
        Width="660"
        Height="470"
        MinWidth="600"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText"
                       Text="How do you want to pick the elements?"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="12">
            <StackPanel>
                <Button x:Name="ClickModeButton"
                        Height="58"
                        HorizontalContentAlignment="Left"
                        Padding="12,0,12,0"
                        Click="click_mode_click">
                    <StackPanel>
                        <TextBlock Text="Click one at a time"
                                   FontWeight="SemiBold" />
                        <TextBlock Foreground="DimGray"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Text="Click a tag or an element and it is processed straight away. Keep clicking; press Esc to stop." />
                    </StackPanel>
                </Button>

                <Button x:Name="BatchModeButton"
                        Height="58"
                        Margin="0,10,0,0"
                        HorizontalContentAlignment="Left"
                        Padding="12,0,12,0"
                        Click="batch_mode_click">
                    <StackPanel>
                        <TextBlock Text="Batch select &amp; process"
                                   FontWeight="SemiBold" />
                        <TextBlock Foreground="DimGray"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Text="Cross-select as many elements as you like, narrow them down with Filter, then process the lot in one undo step." />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#E6E6E6"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="10"
                Margin="0,10,0,0"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="ReferenceText"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="RunningText"
                           Foreground="DimGray"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="ReportButton"
                    Content="Show report"
                    Width="120"
                    Height="34"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="report_click" />
            <Button x:Name="BackButton"
                    Content="Back"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="back_click" />
            <Button x:Name="CancelButton"
                    Content="Close"
                    Width="100"
                    Height="34"
                    IsCancel="True"
                    Click="cancel_click" />
        </StackPanel>
    </Grid>
</Window>
