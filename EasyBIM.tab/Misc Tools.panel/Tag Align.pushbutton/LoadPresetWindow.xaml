<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Previous Settings"
        Width="860"
        Height="600"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Load Previous Settings"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Text="Last used is written for you every time you run an align, so it is here even if you never pressed Save. References are matched to this model by family and type name." />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel x:Name="PresetPanel" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="#B06000"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="RenameButton"
                        Content="Rename"
                        Width="100"
                        Height="34"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="rename_click" />
                <Button x:Name="DeleteButton"
                        Content="Delete"
                        Width="100"
                        Height="34"
                        IsEnabled="False"
                        Click="delete_click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="LoadButton"
                        Content="Load"
                        Width="110"
                        Height="34"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="load_click" />
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100"
                        Height="34"
                        IsCancel="True"
                        Click="cancel_click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
