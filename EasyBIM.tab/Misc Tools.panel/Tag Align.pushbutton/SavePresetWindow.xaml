<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Settings"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Save Settings"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox"
                     Height="28"
                     Padding="4,3,4,3"
                     VerticalContentAlignment="Center"
                     TextChanged="name_changed" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="12">
            <StackPanel>
                <TextBlock Text="Save to" FontWeight="SemiBold" Margin="0,0,0,6" />

                <RadioButton x:Name="LocalRadio"
                             GroupName="TagAlignPresetTarget"
                             IsChecked="True"
                             Margin="0,2,0,2"
                             Checked="target_changed">
                    <StackPanel>
                        <TextBlock Text="This computer" FontWeight="SemiBold" />
                        <TextBlock Foreground="DimGray"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Text="Available in every model you open. Only you see it." />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ModelRadio"
                             GroupName="TagAlignPresetTarget"
                             Margin="0,10,0,2"
                             ToolTipService.ShowOnDisabled="True"
                             Checked="target_changed">
                    <StackPanel>
                        <TextBlock Text="This model" FontWeight="SemiBold" />
                        <TextBlock Foreground="DimGray"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Text="Stored inside the .rvt, so it travels with the model. On an ACC cloud model your team sees it after Sync to Central." />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SharedRadio"
                             GroupName="TagAlignPresetTarget"
                             Margin="0,10,0,2"
                             Checked="target_changed">
                    <StackPanel>
                        <TextBlock Text="Shared folder" FontWeight="SemiBold" />
                        <TextBlock Foreground="DimGray"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Text="A network drive, or an ACC Desktop Connector folder. Your team sees it straight away." />
                    </StackPanel>
                </RadioButton>

                <Grid x:Name="SharedPathGrid" Margin="22,6,0,0" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SharedPathTextBox"
                             Grid.Column="0"
                             Height="26"
                             Padding="4,2,4,2"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="Browse..."
                            Width="90"
                            Height="26"
                            Margin="8,0,0,0"
                            Click="browse_click" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="#B06000"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="110"
                    Height="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="save_click" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="34"
                    IsCancel="True"
                    Click="cancel_click" />
        </StackPanel>
    </Grid>
</Window>
