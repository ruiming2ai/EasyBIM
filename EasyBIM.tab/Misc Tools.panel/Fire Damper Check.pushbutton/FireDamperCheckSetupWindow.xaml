<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Damper Check"
        Width="900"
        Height="780"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Fire Damper Check"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       Text="Read-only. Every duct that crosses a rated wall or floor - in this model or a loaded link - is checked for a fire damper at the crossing. Rated barriers come from a rating parameter, the types you tick, and the drawn fire-rating lines whose styles you tick. Nothing in the model is changed." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Rated barriers, per model"
                                   FontWeight="SemiBold" />
                        <TextBlock Foreground="DimGray"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Text="Each loaded link and this model: pick the rating parameter, confirm the rated wall and floor types (pre-ticked by the parameter and by name), and tick the line styles that draw fire ratings. Remembered by name per link." />
                    </StackPanel>
                    <Border Grid.Row="1"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LinksPanel" Margin="6" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Which family types are fire dampers"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="DamperAllButton" Content="All" Width="56" Height="26" Margin="0,0,6,0" Click="damper_all_click" />
                            <Button x:Name="DamperNoneButton" Content="None" Width="56" Height="26" Click="damper_none_click" />
                        </StackPanel>
                        <TextBlock x:Name="DamperCountText"
                                   Foreground="DimGray"
                                   FontSize="11"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="0 of 0 types ticked as fire dampers." />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,8,0,6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Search"
                                   Foreground="DimGray"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="DamperSearchBox"
                                 Height="24"
                                 VerticalContentAlignment="Center"
                                 TextChanged="damper_search_changed" />
                    </DockPanel>
                    <Border Grid.Row="2"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DamperPanel" Margin="6" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#E3E3E3"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Scope and rule" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <RadioButton x:Name="ScopeModelRadio" GroupName="FireDamperScope" Content="Whole model" IsChecked="True" Margin="0,2,0,2" Checked="scope_changed" />
                    <RadioButton x:Name="ScopeViewRadio" GroupName="FireDamperScope" Content="Ducts in the active view" Margin="0,2,0,2" ToolTipService.ShowOnDisabled="True" Checked="scope_changed" />
                    <CheckBox x:Name="IncludeFloorsCheck" Content="Include rated floors (risers through slabs)" IsChecked="True" Margin="0,6,0,2" Checked="floors_changed" Unchecked="floors_changed" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="A fire damper within" VerticalAlignment="Center" />
                        <TextBox x:Name="NearBox" Width="60" Height="24" Margin="6,0,6,0" Text="600" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="near_changed" />
                        <TextBlock Text="mm of the crossing, at most" VerticalAlignment="Center" />
                        <TextBox x:Name="HopsBox" Width="40" Height="24" Margin="6,0,6,0" Text="3" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="hops_changed" />
                        <TextBlock Text="connection(s) along the run, covers it." VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="A damper whose body sits in the barrier always covers. Both numbers can be changed live in the report without rescanning." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Drawn fire-rating lines" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Foreground="DimGray" FontSize="11" TextWrapping="Wrap"
                               Text="A ticked line becomes a vertical barrier standing on its view's level. It reaches up to:" />
                    <RadioButton x:Name="BandNextLevelRadio" GroupName="FireDamperBand" Content="the next level above" IsChecked="True" Margin="0,4,0,2" Checked="band_changed" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <RadioButton x:Name="BandFixedRadio" GroupName="FireDamperBand" Content="a fixed height of" VerticalAlignment="Center" Checked="band_changed" />
                        <TextBox x:Name="BandHeightBox" Width="60" Height="24" Margin="6,0,6,0" Text="3000" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="band_changed" />
                        <TextBlock Text="mm" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Lines have no thickness; 200 mm is assumed. They mark where the architect drew them, which may not be the wall's centreline." />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3"
                   LastChildFill="False"
                   Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       Text="Links are read, never written. Nested links cannot be reached." />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="110"
                    Height="34"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="cancel_click" />
            <Button x:Name="CheckButton"
                    Content="Check"
                    Width="110"
                    Height="34"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    Click="check_click" />
        </DockPanel>
    </Grid>
</Window>
