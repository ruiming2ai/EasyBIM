<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Schedules from Excel"
        Width="640"
        Height="520"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Type Parameter Conflicts" FontSize="30" FontWeight="SemiBold" Foreground="#C0392B"/>
            <TextBlock x:Name="subtitle_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray"
                       Text="Nothing was imported. Rows of the same element type disagree on the values below. Fix the Excel file and run the import again."
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="conflicts_tb"
                         IsReadOnly="True"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Close" Width="100" Height="34" IsCancel="True" IsDefault="True" Click="close_click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
