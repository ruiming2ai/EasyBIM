<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Boundary"
        Width="960"
        Height="820"
        MinWidth="820"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="360" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Space Boundary"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       Text="Draw room and space boundaries as filled regions, and keep track of them. Which region belongs to which room is written into this model, on the region itself, so it survives a Sync to Central and reaches everyone who opens the job - on a cloud or ACC model too." />
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <TabItem x:Name="CreateTab" Header="Create Boundaries">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Source: this model and every loaded link -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="100" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Where the rooms or spaces come from"
                                           FontWeight="SemiBold" />
                                <TextBlock Foreground="DimGray"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Text="Tick any combination of this model and the loaded links. An MEP job can convert its own spaces and an architectural link's rooms in one run. Remembered by name; a link placed twice is two sources at their own positions." />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Convert" VerticalAlignment="Center" />
                                    <ComboBox x:Name="KindCombo"
                                              Width="120"
                                              Height="26"
                                              Margin="8,0,8,0"
                                              SelectionChanged="kind_changed" />
                                    <TextBlock x:Name="SourceCountText"
                                               Foreground="DimGray"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="0 of 0 sources ticked." />
                                </StackPanel>
                            </StackPanel>

                            <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SourceAllButton" Content="All" Width="56" Height="26" Margin="8,0,6,0" Click="source_all_click" />
                                    <Button x:Name="SourceNoneButton" Content="None" Width="56" Height="26" Click="source_none_click" />
                                </StackPanel>
                                <TextBox x:Name="SourceSearchBox"
                                         Height="24"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Narrow the list by name."
                                         TextChanged="source_search_changed" />
                            </DockPanel>

                            <TextBlock Grid.Row="2"
                                       x:Name="SourceNoteText"
                                       Foreground="DimGray"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />

                            <Border Grid.Row="3"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="SourcePanel" Margin="6" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Where: the active view, or the views you tick -->
                    <Border Grid.Row="0" Grid.Column="2"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="100" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Which views to draw in"
                                           FontWeight="SemiBold" />
                                <RadioButton x:Name="ScopeActiveViewRadio"
                                             GroupName="SpaceBoundaryScope"
                                             Content="The active view"
                                             IsChecked="True"
                                             Margin="0,6,0,2"
                                             Checked="scope_changed" />
                                <RadioButton x:Name="ScopeSelectedViewsRadio"
                                             GroupName="SpaceBoundaryScope"
                                             Content="The views I tick below"
                                             Margin="0,2,0,2"
                                             Checked="scope_changed" />
                                <TextBlock Foreground="DimGray"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Each view is drawn with the rooms on its own level, in its own phase - a Level 2 plan draws Level 2 rooms. Ceiling plans are offered but not ticked: an RCP shows the room outline, never the ceiling edge." />
                            </StackPanel>

                            <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="ViewAllButton" Content="All" Width="56" Height="26" Margin="8,0,6,0" Click="view_all_click" />
                                    <Button x:Name="ViewNoneButton" Content="None" Width="56" Height="26" Click="view_none_click" />
                                </StackPanel>
                                <TextBox x:Name="ViewSearchBox"
                                         Height="24"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Narrow the list by view name."
                                         TextChanged="view_search_changed" />
                            </DockPanel>

                            <TextBlock Grid.Row="2"
                                       x:Name="ViewCountText"
                                       Foreground="DimGray"
                                       FontSize="11"
                                       Margin="0,6,0,0"
                                       Text="0 of 0 views ticked." />

                            <Border Grid.Row="3"
                                    x:Name="ViewsCard"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ViewsPanel" Margin="6" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- What and how -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3"
                            BorderBrush="#E3E3E3"
                            BorderThickness="1"
                            Background="#FAFAFA"
                            Padding="10"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="How much" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <RadioButton x:Name="SubjectAllRadio"
                                             GroupName="SpaceBoundarySubject"
                                             Content="Every room or space in the ticked sources"
                                             IsChecked="True"
                                             Margin="0,2,0,2"
                                             Checked="subject_changed" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <RadioButton x:Name="SubjectOneRadio"
                                                 GroupName="SpaceBoundarySubject"
                                                 Content="Just one I pick"
                                                 VerticalAlignment="Center"
                                                 Checked="subject_changed" />
                                    <Button x:Name="PickButton"
                                            Content="Pick..."
                                            Width="76"
                                            Height="26"
                                            Margin="10,0,8,0"
                                            ToolTip="This window closes while you pick in the model, then comes back."
                                            Click="pick_click" />
                                    <TextBlock x:Name="PickedText"
                                               Foreground="DimGray"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="nothing picked yet" />
                                </StackPanel>
                                <CheckBox x:Name="ReplaceExistingCheck"
                                          Content="Redraw regions that already exist"
                                          Margin="0,8,0,2"
                                          ToolTip="Off, a room that already has a region in a view is skipped as already drawn. On, the old region is deleted and drawn again - any hand edits to it are lost."
                                          Checked="option_changed"
                                          Unchecked="option_changed" />
                                <CheckBox x:Name="IncludeDesignOptionCheck"
                                          Content="Include rooms in design options"
                                          Margin="0,2,0,2"
                                          Checked="option_changed"
                                          Unchecked="option_changed" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="What the boundary means" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <RadioButton x:Name="BoundaryDocumentRadio"
                                             GroupName="SpaceBoundaryLocation"
                                             Content="This model's own setting"
                                             IsChecked="True"
                                             Margin="0,2,0,2"
                                             Checked="boundary_changed" />
                                <TextBlock x:Name="BoundaryResolvedText"
                                           Foreground="DimGray"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="20,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <RadioButton x:Name="BoundaryOverrideRadio"
                                                 GroupName="SpaceBoundaryLocation"
                                                 Content="Measure to"
                                                 VerticalAlignment="Center"
                                                 Checked="boundary_changed" />
                                    <ComboBox x:Name="BoundaryOverrideCombo"
                                              Width="150"
                                              Height="26"
                                              Margin="8,0,0,0"
                                              SelectionChanged="boundary_changed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Draw with" VerticalAlignment="Center" />
                                    <ComboBox x:Name="RegionTypeCombo"
                                              Width="220"
                                              Height="26"
                                              Margin="8,0,0,0"
                                              SelectionChanged="region_type_changed" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CheckTab" Header="Check Differences">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Compare every tracked region with the room it stands for"
                               FontSize="15"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1"
                               x:Name="CheckSummaryText"
                               Foreground="DimGray"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="DimGray"
                                   Text="The record on each region says which room it was drawn from, in which view, measured to which boundary, and what both outlines looked like at the time. The check re-reads both sides and reports what moved:" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="• the room's boundary changed - the region can be redrawn" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="• the region was edited or moved by hand - redraw it, accept it as it now is, or set it aside" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="• the room is gone, the view no longer shows it, or the region was copied into another view - these are deleted or set aside, never redrawn, because redrawing would not fix them" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="• rooms in the ticked views with no region yet - these can be created" />
                        <TextBlock Foreground="DimGray"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Text="Each room is measured the way its own region was drawn, so changing this model's Area and Volume Computation setting afterwards does not turn the whole job into false drift." />
                        <Button x:Name="CheckButton"
                                Content="Check Differences"
                                Width="180"
                                Height="34"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Click="check_click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       Text="Nothing is drawn until you have seen the preview." />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="110"
                    Height="34"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="cancel_click" />
            <Button x:Name="PreviewButton"
                    Content="Preview..."
                    Width="130"
                    Height="34"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    ToolTip="Read the rooms and show exactly what would be drawn and what would be skipped, before anything is written."
                    Click="preview_click" />
        </DockPanel>
    </Grid>
</Window>
