<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Boundary - Differences"
        Width="1020"
        Height="780"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Space Boundary"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Text="Every filled region that carries a room relationship, judged against the room as it is now." />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Text="Search"
                           Foreground="DimGray"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="SearchBox"
                         Height="26"
                         VerticalContentAlignment="Center"
                         ToolTip="Room number, room name, view name or link."
                         TextChanged="search_changed" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="12">
            <Grid>
                <TextBlock x:Name="EmptyText"
                           Visibility="Collapsed"
                           Foreground="DimGray"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="Refresh" Width="104" Height="36" Margin="0,0,8,0" ToolTip="Re-read the regions and the rooms; search and expanded groups survive." Click="refresh_click" />
                    <Button x:Name="ExpandAllButton" Content="Expand All" Width="104" Height="36" Margin="0,0,8,0" Click="expand_all_click" />
                    <Button x:Name="CollapseAllButton" Content="Collapse All" Width="108" Height="36" Margin="0,0,8,0" Click="collapse_all_click" />
                    <Button x:Name="CloseButton" Content="Close" Width="104" Height="36" IsCancel="True" Click="close_click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
