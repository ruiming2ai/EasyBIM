<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Boundary - Preview"
        Width="980"
        Height="780"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="What would be drawn"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                x:Name="RefusalCard"
                BorderBrush="#E0B4B4"
                BorderThickness="1"
                Background="#FDF1F1"
                Padding="10"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <TextBlock x:Name="RefusalText"
                       TextWrapping="Wrap"
                       Foreground="#8B2E2E" />
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,14,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Search"
                               Foreground="DimGray"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox"
                             Height="26"
                             VerticalContentAlignment="Center"
                             TextChanged="search_changed" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="CountText"
                               Foreground="DimGray"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button x:Name="SelectAllButton" Content="All" Width="60" Height="26" Margin="0,0,6,0" Click="select_all_click" />
                    <Button x:Name="SelectNoneButton" Content="None" Width="60" Height="26" Margin="0,0,6,0" Click="select_none_click" />
                    <Button x:Name="ExpandAllButton" Content="Expand All" Width="96" Height="26" Margin="0,0,6,0" Click="expand_all_click" />
                    <Button x:Name="CollapseAllButton" Content="Collapse All" Width="102" Height="26" Click="collapse_all_click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="12">
            <Grid>
                <TextBlock x:Name="EmptyText"
                           Visibility="Collapsed"
                           Foreground="DimGray"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                x:Name="AckCard"
                BorderBrush="#E3D6A8"
                BorderThickness="1"
                Background="#FDFBF0"
                Padding="10"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel x:Name="AckPanel" />
        </Border>

        <DockPanel Grid.Row="5"
                   LastChildFill="False"
                   Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="110"
                    Height="34"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="cancel_click" />
            <Button x:Name="DrawButton"
                    Content="Draw"
                    Width="130"
                    Height="34"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    ToolTip="One undo step for the whole run."
                    Click="draw_click" />
            <Button x:Name="BackButton"
                    Content="Back"
                    Width="110"
                    Height="34"
                    DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    ToolTip="Return to the setup with your choices intact."
                    Click="back_click" />
        </DockPanel>
    </Grid>
</Window>
