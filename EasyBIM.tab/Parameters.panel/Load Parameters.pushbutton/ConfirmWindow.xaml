<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Parameters - Confirm"
        Width="760"
        Height="620"
        MinWidth="600"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText"
                           FontFamily="Consolas"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <CheckBox x:Name="UpgradeCheck"
                      Visibility="Collapsed"
                      Foreground="#B06000"
                      Click="acknowledge_changed">
                <TextBlock TextWrapping="Wrap"
                           Text="I understand that family files saved in an older Revit will be upgraded and cannot be opened in that release again." />
            </CheckBox>
            <CheckBox x:Name="BindingCheck"
                      Visibility="Collapsed"
                      Foreground="#B06000"
                      Margin="0,6,0,0"
                      Click="acknowledge_changed">
                <TextBlock TextWrapping="Wrap"
                           Text="I understand that changing a bound parameter between Instance and Type discards its existing values." />
            </CheckBox>
            <TextBlock x:Name="DialogNoteText"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ProceedButton"
                    Content="Load"
                    Width="120"
                    Height="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    ToolTipService.ShowOnDisabled="True"
                    Click="proceed_click" />
            <Button Content="Cancel"
                    Width="120"
                    Height="34"
                    IsCancel="True"
                    Click="cancel_click" />
        </StackPanel>
    </Grid>
</Window>
