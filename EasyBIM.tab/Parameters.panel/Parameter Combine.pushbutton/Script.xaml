<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Combine"
        Height="860"
        Width="1320"
        MinHeight="760"
        MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Parameter Combine" FontSize="36" FontWeight="SemiBold"/>
            <TextBlock x:Name="scope_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Source Parameters:" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Border Grid.Row="1" BorderBrush="#d0d0d0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Height="28" Margin="0,0,0,8">
                            <TextBlock Text="Parameter Name Search:" Width="170" VerticalAlignment="Center"/>
                            <TextBox x:Name="source_search_tb" TextChanged="source_filter_changed" VerticalContentAlignment="Center" Padding="6,2,6,2"/>
                        </DockPanel>
                        <Expander Header="Filter Available Fields" IsExpanded="True">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Parameter Type:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="source_ptype_cb" Grid.Row="0" Grid.Column="1" Margin="8,0,0,4" SelectionChanged="source_filter_changed"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Data Type:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="source_dtype_cb" Grid.Row="0" Grid.Column="4" Margin="8,0,0,4" SelectionChanged="source_filter_changed"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Discipline:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="source_disc_cb" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="source_filter_changed"/>

                                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="source_type_cb" Content="Type" Margin="0,0,12,0" Click="source_filter_changed"/>
                                    <CheckBox x:Name="source_inst_cb" Content="Instance" Click="source_filter_changed"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>

                <ListBox x:Name="source_lb"
                         Grid.Row="2"
                         BorderBrush="#b9b9b9"
                         BorderThickness="1"
                         DisplayMemberPath="display"
                         SelectionMode="Extended"
                         SelectionChanged="source_selection_changed"
                         FontSize="14"/>

                <TextBlock x:Name="source_count_tb" Grid.Row="3" Margin="0,8,0,0" Foreground="DimGray"/>
            </Grid>

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Target Parameters:" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Border Grid.Row="1" BorderBrush="#d0d0d0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Height="28" Margin="0,0,0,8">
                            <TextBlock Text="Parameter Name Search:" Width="170" VerticalAlignment="Center"/>
                            <TextBox x:Name="target_search_tb" TextChanged="target_filter_changed" VerticalContentAlignment="Center" Padding="6,2,6,2"/>
                        </DockPanel>
                        <Expander Header="Filter Available Fields" IsExpanded="True">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Parameter Type:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="target_ptype_cb" Grid.Row="0" Grid.Column="1" Margin="8,0,0,4" SelectionChanged="target_filter_changed"/>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Data Type:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="target_dtype_cb" Grid.Row="0" Grid.Column="4" Margin="8,0,0,4" SelectionChanged="target_filter_changed"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Discipline:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="target_disc_cb" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="target_filter_changed"/>

                                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="target_type_cb" Content="Type" Margin="0,0,12,0" Click="target_filter_changed"/>
                                    <CheckBox x:Name="target_inst_cb" Content="Instance" Click="target_filter_changed"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>

                <ListBox x:Name="target_lb"
                         Grid.Row="2"
                         BorderBrush="#b9b9b9"
                         BorderThickness="1"
                         DisplayMemberPath="display"
                         SelectionMode="Extended"
                         FontSize="14"/>

                <TextBlock x:Name="target_count_tb" Grid.Row="3" Margin="0,8,0,0" Foreground="DimGray"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#d0d0d0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Combined Parameter Values Format:"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <Button Grid.Row="1"
                        Width="200"
                        Height="34"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="add_selected_to_format">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="+"
                                   Foreground="#2E7D32"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Add Parameters &#x2193;"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <RichTextBox x:Name="combine_format_rtb"
                             Grid.Row="2"
                             Width="760"
                             Height="72"
                             Margin="0,8,0,0"
                             HorizontalAlignment="Center"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="combine_format_preview_keydown"/>

                <StackPanel Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="Example:" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="xx: [Parameter A] - [Parameter B] + [Parameter C] xxx"
                               FontSize="14"
                               Foreground="DimGray"/>
                </StackPanel>

                <TextBlock x:Name="token_help_tb"
                           Grid.Row="4"
                           Margin="0,8,0,0"
                           Foreground="DimGray"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#d0d0d0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Description: Combine selected source parameter values to selected target parameters using the format template. Target parameters must be Text or Multi-line Text."
                           FontSize="16"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="status_tb"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="DimGray"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="Run" Width="120" Height="36" Margin="0,0,8,0" Click="run_click"/>
                    <Button Content="Cancel" Width="120" Height="36" Click="cancel_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

