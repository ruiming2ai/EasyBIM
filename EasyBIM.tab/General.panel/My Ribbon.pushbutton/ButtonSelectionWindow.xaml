<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Ribbon - Which buttons?"
        Width="820"
        Height="860"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="240"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="header_tb" Text="Which buttons?" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="subtitle_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border x:Name="warning_border" Grid.Row="1" Background="#FFF7E0" BorderBrush="#E0C060" BorderThickness="1" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="warning_tb" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Expand All" Width="100" Height="30" Margin="8,0,8,0" Click="expand_all_click"/>
                <Button Content="Collapse All" Width="110" Height="30" Click="collapse_all_click"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="11" FontWeight="SemiBold" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Height="28" VerticalAlignment="Center" TextChanged="search_changed"/>
        </DockPanel>

        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ButtonListPanel"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Select All" Width="100" Height="34" Margin="0,0,8,0" Click="select_all_click"/>
                    <Button Content="Select None" Width="100" Height="34" Click="select_none_click"/>
                </StackPanel>
                <TextBlock x:Name="status_tb" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                    <Button x:Name="next_btn" Content="Next" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="next_click"/>
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
