<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Ribbon - Where from?"
        Width="820"
        Height="660"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Where are the tools?" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Installed pyRevit extensions, Revit's own tabs, other add-ins and Dynamo graphs can be used as they are. To add an extension this computer does not have yet, install it in pyRevit's own Extensions window first - it then appears in the list below."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Every star row carries a MinHeight (see Families Transfer's source page). -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Extension &amp; Tab List" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Already on this computer: pyRevit extensions, Revit's own tabs, other add-ins." Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="installed_count_tb" Margin="0,2,0,0" FontSize="13" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,8,0,8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="4">
                        <ListBox x:Name="InstalledList" BorderThickness="0" SelectionChanged="installed_selection_changed" MouseDoubleClick="installed_double_click"/>
                    </Border>

                    <Button x:Name="use_installed_btn" Grid.Row="2" Content="Use selected" Width="120" Height="30" HorizontalAlignment="Right" IsEnabled="False" Click="use_installed_click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
                <DockPanel LastChildFill="True">
                    <Button x:Name="add_dynamo_btn" DockPanel.Dock="Right" Content="Add Dynamo graph..." Width="170" Height="30" Margin="8,0,0,0" VerticalAlignment="Top" Click="add_dynamo_click"/>
                    <StackPanel>
                        <TextBlock Text="Dynamo" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Pick one or more .dyn files. Each becomes a button that runs the graph where it lives (edits count next time); the icon is Dynamo's own unless you choose a PNG. A graph saved in Manual run mode runs from a copy set to Automatic, because pyRevit will not run a manual graph at all. Needs one pyRevit reload." Margin="0,4,0,0" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status_tb" Grid.Column="0" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
