<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Downgrade Packages"
        Width="760"
        Height="520"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Export Downgrade Packages" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="count_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Package folder" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="One sub-folder per family is written here, named &lt;Family&gt;.downgrade, holding manifest.json and the geometry files. Existing packages of the same name are replaced after one warning."
                               Margin="0,4,0,6" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,14">
                        <Button x:Name="browse_btn" DockPanel.Dock="Right" Content="Browse..." Width="100" Height="30" Margin="8,0,0,0" Click="browse_click"/>
                        <TextBox x:Name="folder_box" Height="30" VerticalContentAlignment="Center" FontSize="13"/>
                    </DockPanel>

                    <TextBlock Text="Options" FontSize="15" FontWeight="SemiBold"/>
                    <CheckBox x:Name="split_types_cb" Margin="0,8,0,2">
                        <TextBlock Text="One family per type" FontSize="13"/>
                    </CheckBox>
                    <TextBlock Text="Off: one package per family; the solids come from the family's current type and every type keeps its parameter values. On: one package per type, each with that type's exact geometry and connector positions - the right choice for MEP fittings whose sizes differ per type."
                               Margin="22,0,0,10" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>

</StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                <Button Content="Export" Width="110" Height="34" Margin="0,0,8,0" IsDefault="True" Click="export_click"/>
                <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
