<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downgrade Families"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Downgrade Families" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="count_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Target Revit version" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,6" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"
                               Text="A family file belongs to one Revit release and nothing can save it for another, so the release you pick has to write it itself: that Revit is opened in the background, rebuilds the families, and closes again. Pick the newest release the receiving project can open - every step further down remaps more."/>
                    <ComboBox x:Name="target_cb" Height="32" Width="420" Margin="0,0,0,6"
                              HorizontalAlignment="Left" Padding="6,2,6,2"
                              SelectionChanged="target_changed"/>
                    <TextBlock x:Name="target_note_tb" Margin="0,0,0,12" FontSize="13"
                               Foreground="#B03A2E" TextWrapping="Wrap"/>

                    <TextBlock Text="Output folder for the .rfa files" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,6" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"
                               Text="One .rfa per family lands here, with families_downgrade_report.txt beside them listing what each family lost. Files of the same name are replaced after one warning."/>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="browse_btn" DockPanel.Dock="Right" Content="Browse..."
                                Width="100" Height="30" Margin="8,0,0,0" Click="browse_click"/>
                        <TextBox x:Name="output_box" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                    </DockPanel>

                    <TextBlock Text="Options" FontSize="15" FontWeight="SemiBold"/>
                    <CheckBox x:Name="split_types_cb" Margin="0,6,0,2">
                        <TextBlock Text="One family per type" FontSize="13"/>
                    </CheckBox>
                    <TextBlock Margin="22,0,0,10" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"
                               Text="Off: one file per family; the solids come from the family's current type and every type keeps its parameter values. On: one file per type, each with that type's exact geometry and connector positions - the right choice for MEP fittings whose sizes differ per type."/>

                    <TextBlock x:Name="status_tb" Margin="0,4,0,0" FontSize="13"
                               Foreground="DimGray" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back" Width="100" Height="34" Margin="0,0,8,0" Click="back_click"/>
                <Button Content="Downgrade" Width="120" Height="34" Margin="0,0,8,0" IsDefault="True" Click="downgrade_click"/>
                <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
