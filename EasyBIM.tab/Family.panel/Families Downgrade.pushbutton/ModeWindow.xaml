<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Families Downgrade"
        Width="760"
        Height="620"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Families Downgrade" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="host_tb" Margin="0,6,0,0" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="A Revit family cannot be saved for an older release - no version of Revit and nothing in its API can write one release's family file from another. Families Downgrade rebuilds the family instead, and the release you want has to do the writing itself. Rebuilt solids are static - the parametric geometry does not survive - and everything a family loses on the way is listed in the report next to the files."
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <RadioButton x:Name="downgrade_rb" GroupName="mode" IsChecked="True" Margin="0,4,0,2" Checked="mode_changed">
                        <TextBlock Text="Downgrade families to another Revit version" FontSize="15" FontWeight="SemiBold"/>
                    </RadioButton>
                    <TextBlock Margin="22,0,0,10" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"
                               Text="Pick families, pick the Revit version you need, pick a folder. That Revit is opened in the background, rebuilds the families and closes again, and you are left with .rfa files of that version and nothing to clean up. It has to be installed on this computer."/>

                    <TextBlock Text="Both halves on their own" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,6"
                               Foreground="DimGray"/>

                    <RadioButton x:Name="export_rb" GroupName="mode" Margin="0,4,0,2" Checked="mode_changed">
                        <TextBlock Text="Export downgrade packages" FontSize="15" FontWeight="SemiBold"/>
                    </RadioButton>
                    <TextBlock x:Name="export_hint_tb" Margin="22,0,0,10" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"
                               Text="Write one downgrade package per family into a folder, and stop there. For when the older Revit is on another computer: copy the folder over and use the option below there."/>

                    <RadioButton x:Name="rebuild_rb" GroupName="mode" Margin="0,4,0,2" Checked="mode_changed">
                        <TextBlock Text="Rebuild families from downgrade packages" FontSize="15" FontWeight="SemiBold"/>
                    </RadioButton>
                    <TextBlock Margin="22,0,0,10" FontSize="13" Foreground="DimGray" TextWrapping="Wrap"
                               Text="Read a folder of downgrade packages someone wrote elsewhere and turn them into .rfa files of this Revit's version."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Next" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="next_click"/>
                <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Click="cancel_click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
