<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Types"
        Height="660"
        Width="1180"
        MinHeight="420"
        MinWidth="860"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="family_tb"
                   Grid.Row="0"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,6"
                   TextTrimming="CharacterEllipsis"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="search_tb"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Padding="6,0,6,0"
                     TextChanged="search_changed"/>
            <TextBlock IsHitTestVisible="False"
                       Text="Search by type name, parameter name, or value..."
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Foreground="Gray">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=search_tb}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel.Resources>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Margin" Value="0,0,6,4"/>
                    <Setter Property="Padding" Value="10,0,10,0"/>
                </Style>
            </WrapPanel.Resources>
            <Button x:Name="newtype_b"
                    Content="New Type"
                    ToolTip="Add a family type, seeded from the first existing type - the way Revit's own New does it. FamilyManager copies the current type's values into a new one, so a row shown blank here would not come out blank."
                    Click="new_type_clicked"/>
            <Button x:Name="duplicate_b"
                    Content="Duplicate Type"
                    ToolTip="Copy the selected type's values into a new type."
                    Click="duplicate_type_clicked"/>
            <Button x:Name="delete_b"
                    Content="Delete Type"
                    ToolTip="Mark the selected type(s) for deletion. Click again to undo."
                    Click="delete_type_clicked"/>
            <Button x:Name="filldown_b"
                    Content="Fill Down"
                    ToolTip="Copy the top selected cell's value to the rest of the selection in that column. Typing into one cell of a multi-cell selection does the same thing."
                    Click="fill_down_clicked"/>
            <Button x:Name="hideempty_b"
                    Content="Hide Empty Columns"
                    ToolTip="Hide parameters that no type has a value for."
                    Click="hide_empty_clicked"/>
            <Button x:Name="reload_b"
                    Content="Reload From Family"
                    ToolTip="Re-read the family, discarding every staged (red) edit."
                    Click="reload_clicked"/>
        </WrapPanel>

        <Canvas x:Name="groupband_cv"
                Grid.Row="3"
                Height="20"
                ClipToBounds="True"
                Background="Transparent"/>

        <DataGrid x:Name="types_dg"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  RowHeaderWidth="22"
                  FrozenColumnCount="1"
                  BorderThickness="1"
                  HorizontalGridLinesBrush="#dedede"
                  VerticalGridLinesBrush="#dedede"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  BeginningEdit="grid_beginning_edit"
                  CellEditEnding="grid_cell_edit_ending"/>

        <DockPanel Grid.Row="5" Margin="0,6,0,6">
            <TextBlock x:Name="legend_tb"
                       DockPanel.Dock="Left"
                       Foreground="DimGray"
                       VerticalAlignment="Center"
                       Text="Drag or shift-select cells down a column, then edit one to set them all. Grey cells are read-only. Red cells are staged, not yet written."/>
            <TextBlock x:Name="status_tb"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </DockPanel>

        <DockPanel Grid.Row="6">
            <DockPanel.Resources>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Padding" Value="12,0,12,0"/>
                </Style>
            </DockPanel.Resources>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="export_b"
                        Content="Export to Excel"
                        Margin="0,0,6,0"
                        Click="export_to_excel"/>
                <Button x:Name="import_b"
                        Content="Import from Excel"
                        Click="import_from_excel"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="cancel_b"
                        Content="Cancel"
                        MinWidth="90"
                        Margin="0,0,6,0"
                        IsCancel="True"
                        Click="cancel_clicked"/>
                <Button x:Name="apply_b"
                        Content="Apply Changes"
                        MinWidth="130"
                        FontWeight="SemiBold"
                        Click="apply_changes"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
