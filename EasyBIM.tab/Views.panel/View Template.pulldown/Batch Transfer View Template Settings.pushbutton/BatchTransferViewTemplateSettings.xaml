<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Transfer View Template Settings"
        Height="760"
        Width="1320"
        MinHeight="650"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="ExpandedTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>

        <DataTemplate x:Key="TargetTemplateTemplate">
            <CheckBox Content="{Binding name}"
                      IsChecked="{Binding is_selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,2,0,2"/>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="TargetGroupTemplate"
                                  ItemsSource="{Binding templates}"
                                  ItemTemplate="{StaticResource TargetTemplateTemplate}">
            <DockPanel Margin="0,2,0,2">
                <TextBlock Text="{Binding display_name}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Batch Transfer View Template Settings"
                       FontSize="32"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Copy selected source template settings into checked target view templates."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="DimGray"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.02*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#B9B9B9"
                    BorderThickness="1"
                    Background="#F4F4F4"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="View properties"
                               FontSize="13"
                               Margin="0,0,0,8"/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Number of views with this template assigned:"
                                   DockPanel.Dock="Left"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="assigned_count_tb"
                                   DockPanel.Dock="Left"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#8F8F8F" BorderThickness="1,1,0,1" Background="#EEEEEE" Padding="4,3">
                            <TextBlock Text="Parameter" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#8F8F8F" BorderThickness="1,1,0,1" Background="#EEEEEE" Padding="4,3">
                            <TextBlock Text="Value" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#8F8F8F" BorderThickness="1" Background="#EEEEEE" Padding="4,3">
                            <TextBlock Text="Include" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <ListView x:Name="settings_lv"
                              Grid.Row="3"
                              BorderBrush="#8F8F8F"
                              BorderThickness="1,0,1,1"
                              Background="White"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="21">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Padding="4,1">
                                        <TextBlock Text="{Binding name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Padding="4,1">
                                        <TextBlock Text="{Binding value_text}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="4,1">
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding is_selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock x:Name="settings_count_tb"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Check All" Width="86" Height="28" Margin="0,0,8,0" Click="check_all_settings_click"/>
                            <Button Content="Clear" Width="74" Height="28" Click="clear_settings_click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Source View Template:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="source_template_cb"
                                  Grid.Column="1"
                                  Height="30"
                                  DisplayMemberPath="name"
                                  SelectionChanged="source_template_changed"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Target View Templates"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Target groups are expanded by default. Check templates to receive the selected settings."
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="DimGray"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="View Type Filter:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="view_type_filter_cb"
                                      Grid.Column="1"
                                      Height="28"
                                      SelectionChanged="view_type_filter_changed"/>
                            <Button Grid.Column="2"
                                    Content="Check All"
                                    Width="92"
                                    Height="28"
                                    Margin="10,0,8,0"
                                    Click="check_all_targets_click"/>
                            <Button Grid.Column="3"
                                    Content="Clear"
                                    Width="74"
                                    Height="28"
                                    Click="clear_targets_click"/>
                        </Grid>

                        <TreeView x:Name="target_tv"
                                  Grid.Row="2"
                                  BorderBrush="#B9B9B9"
                                  BorderThickness="1"
                                  ItemTemplate="{StaticResource TargetGroupTemplate}"
                                  ItemContainerStyle="{StaticResource ExpandedTreeItemStyle}"/>

                        <TextBlock x:Name="target_count_tb"
                                   Grid.Row="3"
                                   Margin="0,8,0,0"
                                   Foreground="DimGray"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="status_tb"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Transfer" Width="120" Height="36" Margin="0,0,8,0" IsDefault="True" Click="transfer_click"/>
                    <Button Content="Cancel" Width="120" Height="36" IsCancel="True" Click="cancel_click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
